.role-switch {
  display: flex;
  flex-direction: row;
  background: #F6F7F9;
  border-radius: 12rpx;
  padding: 6rpx;
}

.role-switch-item {
  flex: 1;
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  border-radius: 8rpx;
}

.role-switch-active {
  background: #FFFFFF;
  color: #1F7A5C;
  font-weight: 600;
}

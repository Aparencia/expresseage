.empty-state {
  padding: 96rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.empty-state-btn {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 12rpx;
  background: #1F7A5C;
  color: #FFFFFF;
  font-size: 28rpx;
  margin: 0;
}

.empty-state-btn::after {
  border: none;
}

.empty-state {
  padding: 96rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.empty-state-btn {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 12rpx;
  background: #1F7A5C;
  color: #FFFFFF;
  font-size: 28rpx;
  margin: 0;
}

/* 微信原生 button 默认 width:184px（特异性 0,1,1）：这里用 .empty-state .empty-state-btn(0,2,0)
   覆盖，空态 CTA 按文案自适应宽度、不出现被原生宽度撑出的怪居中 */
.empty-state .empty-state-btn {
  width: auto;
  box-sizing: border-box;
}

.empty-state-btn::after {
  border: none;
}

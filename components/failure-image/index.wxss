.failure-image {
  background: #F6F7F9;
  border-radius: 12rpx;
  padding: 16rpx;
}

.failure-image-img {
  width: 100%;
  border-radius: 8rpx;
  display: block;
}

.failure-image-tip {
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  padding: 48rpx 0;
}

.failure-image-retry {
  font-size: 26rpx;
  color: #1F7A5C;
  text-align: center;
  padding: 8rpx 0 24rpx;
}

.failure-image-note {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
  line-height: 1.5;
}

.failure-image {
  background: var(--v4-bg);
  border-radius: 12rpx;
  padding: 16rpx;
}

.failure-image-img {
  width: 100%;
  border-radius: 8rpx;
  display: block;
}

.failure-image-tip {
  font-size: 26rpx;
  color: var(--v4-text-2);
  text-align: center;
  padding: 48rpx 0;
}

.failure-image-retry {
  font-size: 26rpx;
  color: var(--v4-brand);
  text-align: center;
  padding: 8rpx 0 24rpx;
}

.failure-image-note {
  font-size: 22rpx;
  color: var(--v4-text-3, #6B6B6B);
  margin-top: 12rpx;
  line-height: 1.5;
}

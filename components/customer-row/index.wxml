<view class="customer-row" bindtap="onTap">
  <avatar-view fileId="{{customer.avatarFileId}}" name="{{customer.displayName}}" size="64" />
  <view class="customer-row-main">
    <view class="customer-row-name ellipsis">{{customer.displayName || '代客单'}}</view>
    <view class="customer-row-meta">{{customer.anchorText}}</view>
    <view wx:if="{{customer.customerNoDisplay}}" class="customer-row-no">{{customer.customerNoDisplay}}</view>
  </view>
  <text class="customer-row-arrow">›</text>
</view>

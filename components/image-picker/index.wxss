.image-picker-previews {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.image-picker-item {
  position: relative;
  width: 180rpx;
}

.image-picker-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
}

.image-picker-remove {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx 0 12rpx 0;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
}

.image-picker-progress {
  font-size: 26rpx;
  color: #666666;
  padding: 12rpx 0;
}

.image-picker-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.image-picker-btn {
  flex: 1;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  color: #1F7A5C;
  margin: 0;
}

.image-picker-btn::after {
  border: none;
}

.status-pill {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.status-pending {
  background: #EDF2F7;
  color: #5B7B9A;
}

.status-accepted {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.status-picked {
  background: #FDF0E6;
  color: #F2994A;
}

.status-delivered {
  background: var(--v4-success-weak);
  color: var(--v4-brand);
}

.status-completed {
  background: var(--v4-brand);
  color: var(--v4-on-accent);
}

.status-cancelled {
  background: #F0F0F0;
  color: var(--v4-text-3, var(--v4-text-3));
}

.status-exception {
  background: var(--v4-danger-weak);
  color: var(--v4-danger);
}

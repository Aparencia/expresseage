/* components/avatar-view/index.wxss · 默认头像底色/字色由 utils/avatar.js 色板内联下发 */
.avatar-wrap {
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 字号由组件按 size 内联下发（size*0.42rpx）：百分比会相对父级 font-size（页面 30rpx）计算，
   会把默认头像首字缩成 13rpx 的「看不清」状态；这里继承内联字号。 */
.avatar-initial {
  font-size: 1em;
  font-weight: 600;
}

.order-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.order-row:last-child {
  border-bottom: none;
}

.order-row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.order-row-code {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-row-line {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 6rpx;
}

.order-row-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.order-row-meta {
  font-size: 24rpx;
  color: #999999;
}

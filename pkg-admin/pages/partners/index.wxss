/* pkg-admin/pages/partners/index.wxss · 兼职列表页页面级样式 */

.filter-block {
  padding-bottom: 12rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-height: 72rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--v4-text-2);
  justify-content: center;
}

.chip-bar {
  width: 100%;
  height: 4rpx;
  margin-top: 8rpx;
  border-radius: 2rpx;
  background: var(--v4-brand);
}

.expand {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--v4-line);
}

.btn-small {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.link {
  color: var(--v4-brand);
}

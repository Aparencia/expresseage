/* pkg-admin/pages/invite-codes/index.wxss · 邀请码页页面级样式 */

.btn-small {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-height: 72rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--v4-text-2);
  justify-content: center;
}

.chip-bar {
  width: 100%;
  height: 4rpx;
  margin-top: 8rpx;
  border-radius: 2rpx;
  background: var(--v4-brand);
}

.code-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--v4-admin);
}

.link {
  color: var(--v4-brand);
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--v4-card);
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
}

.pick-value {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--v4-text);
}

.danger-text {
  margin: 16rpx 0;
  font-size: 26rpx;
  color: var(--v4-danger);
}

.code-box {
  max-height: 42vh;
  margin: 16rpx 0;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
}

.code-line {
  display: block;
  padding: 8rpx 0;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: var(--v4-text);
}

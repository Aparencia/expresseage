/* pkg-admin/pages/config/index.wxss · 全局配置页页面级样式 */

.service-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.toggle-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.form-block {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  margin-top: 8rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #F6F7F9;
  font-size: 30rpx;
}

.info-row {
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.save-action {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.link {
  color: var(--v4-brand);
}

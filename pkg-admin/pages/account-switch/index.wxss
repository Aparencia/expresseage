/* pkg-admin/pages/account-switch/index.wxss · 账号切换页页面级样式 */

.filter-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-height: 72rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--v4-text-2);
  justify-content: center;
}

.chip-bar {
  width: 100%;
  height: 4rpx;
  margin-top: 8rpx;
  border-radius: 2rpx;
  background: var(--v4-brand);
}

.btn-small {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-left: 12rpx;
}

.candidate-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.test-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.detail-row {
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.confirm-card {
  border: 2rpx solid var(--v4-brand);
}

.action-row {
  margin-top: 24rpx;
}

.danger-text {
  margin: 12rpx 0;
  font-size: 26rpx;
  color: var(--v4-danger);
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--v4-card);
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
}

.pick-item {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: var(--v4-text);
}

.link {
  color: var(--v4-brand);
}

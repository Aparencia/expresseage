/* pkg-admin/pages/overview/index.wxss · 总览页页面级样式（其余用 app.wxss 工具类） */

.bell {
  position: relative;
  min-width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
}

.badge {
  position: absolute;
  top: 12rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--v4-danger);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.status-line {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #FFF7E6;
  color: var(--v4-readonly-text);
  font-size: 26rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 0 0 31.5%;
  margin: 0 1% 16rpx 0;
  min-height: 132rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: var(--v4-card);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--v4-admin);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--v4-text-3);
}

.warning {
  color: var(--v4-danger);
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0;
}

.quick {
  flex: 0 0 48%;
  margin: 0 2% 16rpx 0;
  min-height: 88rpx;
  border-radius: 12rpx;
  background: #F0F2F5;
  color: var(--v4-brand);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.audit-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.link {
  color: var(--v4-brand);
}

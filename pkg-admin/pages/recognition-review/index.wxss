/* pkg-admin/pages/recognition-review/index.wxss · 识别失败复核页页面级样式 */

.filter-row {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-height: 72rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--v4-text-2);
  justify-content: center;
}

.chip-bar {
  width: 100%;
  height: 4rpx;
  margin-top: 8rpx;
  border-radius: 2rpx;
  background: var(--v4-brand);
}

.filter-pickers {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.pick-item {
  min-height: 72rpx;
  min-width: 180rpx;
  margin: 0 16rpx 12rpx 0;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: var(--v4-card);
  font-size: 26rpx;
  color: var(--v4-text-2);
  display: flex;
  align-items: center;
}

.expand {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--v4-line);
}

.detail-row {
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.detail-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.detail-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: var(--v4-text-3);
}

.ocr-text {
  display: block;
  padding: 12rpx;
  border-radius: 8rpx;
  background: #F6F7F9;
  font-size: 26rpx;
  word-break: break-all;
}

.btn-small {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.action-gap {
  margin-top: 16rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-panel {
  width: 92%;
  max-height: 86vh;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--v4-card);
  box-sizing: border-box;
  overflow-y: auto;
}

.link {
  color: var(--v4-brand);
}

.ai-status {
  margin-top: 12rpx;
}

/* pkg-admin/pages/customers/index.wxss · 顾客列表页页面级样式 */

.filter-block {
  padding-bottom: 12rpx;
}

.link {
  color: var(--v4-brand);
}

.tag-suspended {
  color: var(--v4-warning-text, #B26A00);
  background: rgba(178, 106, 0, 0.12);
}

.tag-closed {
  color: var(--v4-text-2);
  background: rgba(0, 0, 0, 0.06);
}

.warn-text {
  margin-top: 8rpx;
  color: var(--v4-warning-text, #B26A00);
}

.action-row {
  margin-top: 16rpx;
  justify-content: flex-end;
}

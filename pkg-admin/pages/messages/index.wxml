<view class="page-body">
  <view class="empty-text" wx:if="{{loading}}">加载中…</view>

  <view class="card" wx:if="{{error}}" bindtap="onRetry">
    <text class="muted">没连上服务器，先检查网络；刚才的数据是 {{errorAt}} 的。</text>
    <text class="link"> 点此重试</text>
  </view>

  <block wx:if="{{!loading && !error}}">
    <view class="card" wx:if="{{systemLines.length > 0}}">
      <text class="section-title">系统状态</text>
      <view class="system-line" wx:for="{{systemLines}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="card">
      <text class="section-title">异常工单（{{exceptions.length}}）</text>
      <view class="empty-text" wx:if="{{exceptions.length === 0}}">没有待处理的异常工单。</view>
      <view class="message-row" wx:for="{{exceptions}}" wx:key="orderNo" data-no="{{item.orderNo}}" bindtap="onHandleOrder">
        <view class="row between">
          <text class="strong">{{item.orderNo}}</text>
          <text class="tag">待处理</text>
        </view>
        <view class="danger-text">{{item.exceptionText}}{{item.reportedAtText ? ' · 上报 ' + item.reportedAtText : ''}}{{item.partnerNo ? ' · ' + item.partnerNo : ''}}</view>
        <view class="small">点此处理</view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">识别失败待复核（{{failures.length}}）</text>
      <view class="empty-text" wx:if="{{failures.length === 0}}">没有待复核的识别失败记录。</view>
      <view class="message-row" wx:for="{{failures}}" wx:key="failureNo" data-no="{{item.failureNo}}" bindtap="onReviewFailure">
        <view class="row between">
          <text class="strong">{{item.failureNo}}</text>
          <text class="tag">{{item.failureCodeText}}</text>
        </view>
        <view class="muted">{{item.sourceRoleText}}{{item.uploaderText ? ' · ' + item.uploaderText : ''}} · {{item.createdAtText}}</view>
        <view class="small">去复核</view>
      </view>
    </view>

    <view class="empty-text" wx:if="{{exceptions.length === 0 && failures.length === 0 && systemLines.length === 0}}">没有待处理的后台消息。</view>
  </block>
</view>

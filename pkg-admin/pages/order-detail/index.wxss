/* pkg-admin/pages/order-detail/index.wxss · 订单详情页页面级样式 */

.info-row {
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.danger-text {
  margin: 8rpx 0;
  font-size: 26rpx;
  color: var(--v4-danger);
}

.action-gap {
  margin-top: 24rpx;
}

.event-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

/* v1.0 多包裹：逐件行（单件单不渲染，保持既有视觉） */
.piece-block {
  padding: 12rpx 0;
  border-top: 1rpx solid var(--v4-line);
}

.piece-head {
  margin-bottom: 4rpx;
}

.link {
  color: var(--v4-brand);
}

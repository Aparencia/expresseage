<view class="page-body">
  <view class="card" wx:if="{{forbidden}}">
    <text class="section-title">{{forbidden.title}}</text>
    <text class="muted">{{forbidden.text}}</text>
  </view>
  <block wx:if="{{!forbidden}}">
  <view class="card filter-block">
    <view class="form-row">
      <input class="form-input" value="{{keyword}}" placeholder="订单号 / 顾客编号 / 兼职编号" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" />
    </view>
    <view class="row between">
      <text class="muted">含测试数据</text>
      <switch checked="{{includeTest}}" color="#1F7A5C" bindchange="onIncludeTestChange" />
    </view>
  </view>

  <scroll-view class="filter-row" scroll-x="true">
    <view class="filter-chip" wx:for="{{statusTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTabChange">
      <text>{{item.label}}{{item.countText}}</text>
      <view class="chip-bar" wx:if="{{item.active}}"></view>
    </view>
  </scroll-view>

  <view class="empty-text" wx:if="{{loading}}">加载中…</view>
  <view class="empty-text" wx:if="{{searching}}">搜索中…</view>

  <view class="card" wx:if="{{error}}" bindtap="onRetry">
    <text class="muted">{{error}}</text>
    <text class="link"> 点此重试</text>
  </view>

  <view class="empty-text" wx:if="{{!loading && !searching && !error && list.length === 0}}">{{emptyText}}</view>

  <view class="card" wx:for="{{list}}" wx:key="orderNo" data-no="{{item.orderNo}}" bindtap="onOpenDetail">
    <view class="row between">
      <text class="strong">{{item.orderNo}}</text>
      <view class="row">
        <text class="tag tag-test" wx:if="{{item.isTest}}">测试</text>
        <text class="tag" wx:if="{{item.parcelCountText}}">{{item.parcelCountText}}</text>
        <text class="tag" wx:if="{{item.manualEntryText}}">{{item.manualEntryText}}</text>
        <text class="tag">{{item.statusText}}</text>
      </view>
    </view>
    <view class="muted">{{item.serviceName}} · {{item.dormText}} · {{item.statusUpdatedAtText}}</view>
    <view class="danger-text" wx:if="{{item.exceptionText}}">异常 {{item.exceptionText}}{{item.reportedAtText ? ' · 上报 ' + item.reportedAtText : ''}}{{item.partnerNo ? ' · ' + item.partnerNo : ''}}</view>
  </view>
  </block>
</view>

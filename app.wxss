/* app.wxss · v4 全局设计 token 与通用工具类（唯一全局样式单源）
   规则：页面只写页面级类；token（--v4-*）只在本文件定义；颜色/字号/间距与 CONTRACT §8 一致 */
page {
  --v4-brand: #1F7A5C;
  --v4-customer: #F2994A;
  --v4-partner: #2B6DE5;
  --v4-admin: #3A4A5C;
  --v4-readonly-bg: #FFF4CE;
  --v4-readonly-text: #8A6D00;
  --v4-test-bg: #E8F0FF;
  --v4-test-text: #2B6DE5;
  --v4-danger: #E54D42;
  --v4-warning: #F5A623;
  --v4-text: #1A1A1A;
  --v4-text-2: #666666;
  --v4-text-3: #999999;
  --v4-bg: #F6F7F9;
  --v4-card: #FFFFFF;
  --v4-line: #EEEEEE;
  background: var(--v4-bg);
  color: var(--v4-text);
  font-size: 30rpx;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-body {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--v4-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.between {
  justify-content: space-between;
}

.center {
  justify-content: center;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--v4-text);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 30rpx;
  color: var(--v4-text-2);
}

.muted {
  font-size: 26rpx;
  color: var(--v4-text-3);
}

.small {
  font-size: 24rpx;
  color: var(--v4-text-3);
}

.strong {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 100%;
}

.divider {
  height: 1rpx;
  background: var(--v4-line);
  margin: 16rpx 0;
}

.btn {
  min-height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: none;
  background: var(--v4-brand);
  color: #FFFFFF;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--v4-brand);
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: var(--v4-brand);
  border: 2rpx solid var(--v4-brand);
}

.btn-danger {
  background: var(--v4-danger);
  color: #FFFFFF;
}

.btn-disabled {
  background: #D9DEE5;
  color: #FFFFFF;
}

/* 微信原生 button 默认规则 button:not([size='mini']) { width: 184px }（特异性 0,1,1）
   会压过单类 .btn-block(0,1,0)，使整宽 CTA 变窄且被原生 margin auto 居中。
   这里用叠加 class 提高特异性（0,2,0），整宽/自适应窄按钮不再被原生宽度压回 184px。 */
.btn.btn-block {
  width: 100%;
}

/* 窄按钮（换绑/重试/分享/去完善等）：宽度随内容自适应，行内不被压扁 */
.btn.btn-small,
.btn.mini-btn {
  width: auto;
  flex-shrink: 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #F0F2F5;
  color: var(--v4-text-2);
}

.tag-test {
  background: var(--v4-test-bg);
  color: var(--v4-test-text);
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.hidden {
  display: none;
}

.empty-text {
  padding: 96rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--v4-text-3);
}

.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.form-label {
  width: 180rpx;
  font-size: 30rpx;
  color: var(--v4-text-2);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
}

<!-- pkg-partner/pages/order-detail/index.wxml · 兼职订单详情（动作可见性来自服务端 order.actions；面板数据全部来自 parts 视图件） -->
<view class="page-body detail-body">
  <switch-bar />
  <view wx:if="{{loading}}" class="empty-text">加载中…</view>
  <view wx:elif="{{error}}" class="card">
    <empty-state text="{{error}}" actionText="重试" bind:action="load" />
  </view>

  <block wx:elif="{{order}}">
    <!-- 状态卡：状态文案/编号/动作全部来自服务端 DTO -->
    <view class="card head-card">
      <view class="row between">
        <view class="row">
          <view class="strong order-no">{{order.orderNo}}</view>
          <view class="btn btn-ghost mini-btn copy-btn" bindtap="onCopyOrderNo">复制</view>
        </view>
        <status-pill status="{{order.status}}" />
      </view>
      <view class="row between status-sub">
        <text class="small">{{order.statusText}}</text>
        <text wx:if="{{deliveredChip}}" class="tag guest-chip">{{deliveredChip}}</text>
      </view>

      <view wx:if="{{isGuest}}" class="row guest-row">
        <avatar-view size="{{48}}" />
        <view class="tag guest-tag">代客单</view>
        <text class="small">顾客未绑定，进度需线下告知</text>
      </view>
      <view wx:elif="{{order.counterpart}}" class="row counterpart">
        <avatar-view fileId="{{order.counterpart.avatarFileId}}" name="{{order.counterpart.displayName}}" size="{{64}}" />
        <view class="flex-1 counterpart-main">
          <view class="strong">{{order.counterpart.displayName || '顾客'}}</view>
          <view class="small" bindtap="onCopyCustomerNo">顾客编号 {{customerNoText || '—'}} · 复制</view>
        </view>
      </view>
      <view wx:else class="small customer-no-line" bindtap="onCopyCustomerNo">
        顾客编号 {{customerNoText || '—'}}<text wx:if="{{customerNoText}}"> · 复制</text>
      </view>
      <view wx:if="{{guestAutoHint}}" class="small auto-hint">{{guestAutoHint}}</view>
    </view>

    <!-- 取件信息（L3 只在原位展示，不拼进任何 URL） -->
    <view class="card">
      <view class="row between">
        <view class="section-title">取件信息</view>
        <text wx:if="{{order.codeStatusText}}" class="tag {{order.needCode ? 'tag-test' : ''}}">{{order.codeStatusText}}</text>
      </view>
      <view class="form-row">
        <view class="form-label">站点</view>
        <view class="form-input">{{order.stationText}}</view>
      </view>
      <view class="form-row">
        <view class="form-label">取件码</view>
        <view class="form-input">{{order.pickupCodeText || '需查明'}}</view>
      </view>
      <view class="form-row">
        <view class="form-label">柜号</view>
        <view class="form-input">{{order.lockerNoText || '—'}}</view>
      </view>
      <view class="form-row">
        <view class="form-label">运单尾号</view>
        <view class="form-input">{{order.trackingTailText || '—'}}</view>
      </view>
      <view wx:if="{{order.needCode}}" class="flag-tip">这张单还缺取件码，先补码再取件</view>
      <view wx:if="{{order.failureHint}}" class="flag-tip">识别失败已反馈开发者复核，可手填补码</view>
      <view wx:if="{{order.exceptionText || order.exceptionCodeText}}" class="flag-tip">
        当前异常：{{order.exceptionCodeText}}{{order.exceptionText ? ' · ' + order.exceptionText : ''}}
      </view>
      <view wx:if="{{order.hasImage}}" class="row image-row">
        <view class="btn btn-ghost mini-btn" bindtap="onViewImage">查看取件截图</view>
      </view>
    </view>

    <!-- 服务与备注（服务类型只表达"做什么"，零费用语义） -->
    <view class="card">
      <view class="section-title">服务与备注</view>
      <view class="form-row">
        <view class="form-label">服务类型</view>
        <view class="form-input">{{order.serviceName || '—'}}</view>
      </view>
      <view class="form-row">
        <view class="form-label">预约</view>
        <view class="form-input">{{order.appointText || '尽快'}}</view>
      </view>
      <view class="form-row">
        <view class="form-label">备注</view>
        <view class="form-input">{{order.noteText || '—'}}</view>
      </view>
      <view wx:if="{{order.cancelReasonText}}" class="flag-tip">
        已取消 · 原因：{{order.cancelReasonText}}{{order.cancelledByText ? '（' + order.cancelledByText + '）' : ''}}
      </view>
    </view>

    <!-- 履约凭证（MVP：订单号 + 事件流水 + deliveryNote；本单不可删除） -->
    <view class="card">
      <view class="section-title">{{voucher.title}}</view>
      <view wx:for="{{voucher.rows}}" wx:key="label" class="form-row">
        <view class="form-label">{{item.label}}</view>
        <view class="form-input">{{item.value}}</view>
      </view>
      <view wx:if="{{voucher.partnerNo}}" class="small voucher-no">兼职编号：{{voucher.partnerNo}}</view>
      <view wx:if="{{voucher.guestAuto}}" class="small">{{voucher.guestAuto}}</view>
      <view class="small voucher-footer">{{voucher.footer}}</view>
    </view>

    <!-- 时间线 -->
    <view class="card">
      <view class="section-title">时间线</view>
      <view wx:if="{{!events.length}}" class="small">还没有状态记录</view>
      <view wx:for="{{events}}" wx:key="key" class="event-row">
        <view class="event-time small">{{item.atText}}</view>
        <view class="event-label">{{item.label}}<text wx:if="{{item.actor}}" class="small"> · {{item.actor}}</text></view>
      </view>
    </view>

    <!-- 留言 -->
    <view class="card">
      <view class="row between">
        <view class="section-title">留言</view>
        <view wx:if="{{!readonly}}" class="btn btn-ghost mini-btn" bindtap="onOpenMessage">写留言</view>
      </view>
      <view wx:if="{{!messages.length}}" class="small">还没有留言，有问题可以直接问顾客</view>
      <view wx:for="{{messages}}" wx:key="id" class="message-row">
        <view class="small">{{item.fromText}} · {{item.atText}}</view>
        <view>{{item.text}}</view>
      </view>
    </view>

    <view class="bottom-safe"></view>

    <!-- 底部操作条：只渲染服务端 order.actions[]；READONLY 全部置灰（点击只 toast、不发请求） -->
    <view wx:if="{{actions.length}}" class="action-bar">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="btn {{item.danger ? 'btn-danger' : 'btn-primary'}} action-btn {{item.disabled ? 'btn-disabled' : ''}}"
        disabled="{{item.disabled || sending}}"
        data-key="{{item.key}}"
        bindtap="onActionTap"
      >{{item.label}}</view>
    </view>

    <!-- 撤销条：仅服务端 actions 给出 undoPick/undoDeliver 时出现，5 秒倒计时 -->
    <view wx:if="{{undoBar.visible}}" class="undo-bar">
      <text>{{undoBar.label}} · 可撤销 {{undoBar.remaining}}s</text>
      <view class="btn btn-ghost mini-btn" bindtap="onUndoTap">{{undoBar.undoLabel}}</view>
    </view>
  </block>

  <!-- 补码/改站点面板：站点 picker 值域 = correctPanel.stationOptions（共享 P1~P8） -->
  <view wx:if="{{panel === 'correct'}}" class="panel-mask" bindtap="onPanelClose">
    <view class="panel" catchtap="noop">
      <view class="section-title">{{correctPanel.title}}</view>
      <view wx:if="{{correctPanel.picked}}" class="small">{{correctPanel.hint}}</view>
      <view wx:if="{{correctPanel.showStation}}" class="form-row">
        <view class="form-label">站点</view>
        <picker class="flex-1" range="{{correctPanel.stationOptions}}" range-key="name" value="{{correctPanel.stationIndex}}" bindchange="onStationChange">
          <view class="form-input picker-value">{{correctPanel.stationText}}</view>
        </picker>
      </view>
      <view wx:if="{{correctPanel.showPickupCode}}" class="form-row">
        <view class="form-label">取件码</view>
        <input class="form-input" maxlength="{{correctPanel.pickupCodeMax}}" value="{{correctEditor.pickupCode}}" data-field="pickupCode" bindinput="onCorrectInput" />
      </view>
      <view wx:if="{{correctPanel.showLockerNo}}" class="form-row">
        <view class="form-label">柜号</view>
        <input class="form-input" maxlength="{{correctPanel.lockerNoMax}}" value="{{correctEditor.lockerNo}}" data-field="lockerNo" bindinput="onCorrectInput" />
      </view>
      <view wx:if="{{correctPanel.showTrackingTail}}" class="form-row">
        <view class="form-label">运单尾号</view>
        <input class="form-input" maxlength="{{correctPanel.trackingTailLength}}" type="number" value="{{correctEditor.trackingTail}}" data-field="trackingTail" bindinput="onCorrectInput" />
      </view>
      <view class="small">{{correctPanel.saveCopy}}</view>
      <view wx:if="{{correctError}}" class="error-text">{{correctError}}</view>
      <view class="row panel-actions">
        <view class="btn btn-ghost mini-btn" bindtap="onPanelClose">取消</view>
        <view class="btn btn-primary mini-btn" bindtap="onCorrectSave">{{sending ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- 异常上报面板：六原因 + 备注 ≤200（OTHER 必填） -->
  <view wx:if="{{panel === 'exception'}}" class="panel-mask" bindtap="onPanelClose">
    <view class="panel" catchtap="noop">
      <view class="section-title">{{exceptionPanel.title}}</view>
      <view class="reason-list">
        <view
          wx:for="{{exceptionPanel.reasons}}"
          wx:key="code"
          class="reason-chip {{index === exceptionIndex ? 'reason-chip-active' : ''}}"
          data-index="{{index}}"
          bindtap="onExceptionReasonTap"
        >{{item.label}}</view>
      </view>
      <textarea class="panel-textarea" maxlength="{{exceptionPanel.noteMax}}" placeholder="{{exceptionPanel.placeholder}}" value="{{exceptionNote}}" bindinput="onExceptionNoteInput" />
      <view class="small">{{exceptionPanel.confirmText}}</view>
      <view wx:if="{{exceptionError}}" class="error-text">{{exceptionError}}</view>
      <view class="row panel-actions">
        <view class="btn btn-ghost mini-btn" bindtap="onPanelClose">返回</view>
        <view class="btn btn-danger mini-btn" bindtap="onExceptionSubmit">{{sending ? '上报中…' : '上报异常'}}</view>
      </view>
    </view>
  </view>

  <!-- 送达浮层：deliveryNote ≤100 + 快捷标签；guest 单确认框换成 24h 自动完成文案 -->
  <view wx:if="{{panel === 'deliver'}}" class="panel-mask" bindtap="onPanelClose">
    <view class="panel" catchtap="noop">
      <view class="section-title">{{deliveryPanel.title}}</view>
      <view wx:if="{{deliveryPanel.guest}}" class="small">{{deliveryPanel.guestHint}}</view>
      <view class="small">{{deliveryPanel.confirmText}}</view>
      <view class="small quick-title">{{deliveryPanel.quickTitle}}</view>
      <view class="reason-list">
        <view
          wx:for="{{deliveryPanel.quickTags}}"
          wx:key="*this"
          class="reason-chip"
          data-tag="{{item}}"
          bindtap="onQuickTag"
        >{{item}}</view>
      </view>
      <textarea class="panel-textarea" maxlength="{{deliveryPanel.noteMax}}" placeholder="{{deliveryPanel.placeholder}}" value="{{deliveryNote}}" bindinput="onDeliveryNoteInput" />
      <view wx:if="{{deliveryError}}" class="error-text">{{deliveryError}}</view>
      <view class="row panel-actions">
        <view class="btn btn-ghost mini-btn" bindtap="onPanelClose">返回</view>
        <view class="btn btn-primary mini-btn" bindtap="onDeliverySubmit">{{sending ? '提交中…' : '确认送达'}}</view>
      </view>
    </view>
  </view>

  <!-- 取消/拒单面板：原因枚举（OTHER 必填备注）+ 二次确认后果 -->
  <view wx:if="{{panel === 'reason'}}" class="panel-mask" bindtap="onPanelClose">
    <view class="panel" catchtap="noop">
      <view class="section-title">{{cancelPanel.title}}</view>
      <picker range="{{cancelPanel.reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="onReasonChange">
        <view class="form-input picker-value">{{cancelPanel.reasons[reasonIndex].label}}</view>
      </picker>
      <textarea class="panel-textarea" maxlength="{{cancelPanel.noteMax}}" placeholder="{{cancelPanel.placeholder}}" value="{{reasonNote}}" bindinput="onReasonNoteInput" />
      <view class="small">提交后订单结束，顾客会看到原因；取消后不可恢复。</view>
      <view wx:if="{{reasonError}}" class="error-text">{{reasonError}}</view>
      <view class="row panel-actions">
        <view class="btn btn-ghost mini-btn" bindtap="onPanelClose">返回</view>
        <view class="btn btn-danger mini-btn" bindtap="onReasonSubmit">{{sending ? '提交中…' : '提交'}}</view>
      </view>
    </view>
  </view>

  <!-- 留言面板：≤200 字，说清下一步 -->
  <view wx:if="{{panel === 'message'}}" class="panel-mask" bindtap="onPanelClose">
    <view class="panel" catchtap="noop">
      <view class="section-title">给顾客留言</view>
      <textarea class="panel-textarea" maxlength="200" placeholder="≤200 字，说清楚下一步" value="{{messageText}}" bindinput="onMessageInput" />
      <view class="row panel-actions">
        <view class="btn btn-ghost mini-btn" bindtap="onPanelClose">取消</view>
        <view class="btn btn-primary mini-btn" bindtap="onMessageSend">{{sending ? '发送中…' : '发送'}}</view>
      </view>
    </view>
  </view>
</view>

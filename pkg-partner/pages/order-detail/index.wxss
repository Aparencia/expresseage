/* pkg-partner/pages/order-detail/index.wxss · 订单详情局部样式 */
.head-card {
  padding-bottom: 16rpx;
}

.order-no {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.copy-btn {
  min-height: 56rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.guest-row {
  margin-top: 16rpx;
}

.guest-tag {
  margin: 0 12rpx;
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.counterpart {
  margin-top: 20rpx;
}

.counterpart-main {
  margin-left: 16rpx;
}

.flag-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--v4-readonly-bg);
  color: var(--v4-readonly-text);
  font-size: 26rpx;
}

.image-row {
  margin-top: 16rpx;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.event-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.event-time {
  width: 100rpx;
  flex-shrink: 0;
}

.event-label {
  flex: 1;
}

.message-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

/* D65：操作条固定底盘/env 底垫由 components/bottom-bar 统一提供，本文件只保留条内按钮布局。
   2026-11-05：主操作独占一行（整宽实心），异常/改码/留言/取消 在上一行等宽小号按钮；
   bottom-bar 的 .bb-bar 不是 flex 容器，旧 .action-btn{flex:1} 从未生效——这里显式给行容器 flex。 */
.action-secondary-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin-bottom: 12rpx;
}

.action-secondary-btn {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.action-secondary-btn:last-child {
  margin-right: 0;
}

.action-primary-btn {
  width: 100%;
}

/* 危险但非主操作（取消订单/拒单）：白底红字红边——可识别、不与主操作抢视觉重量，也避免误触即执行 */
.btn-ghost-danger {
  background: var(--v4-card);
  color: var(--v4-danger);
  border: 2rpx solid var(--v4-danger);
}

/* 撤销条：token 组合定位；操作条同时存在时上抬一档，不互相遮挡 */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + var(--v4-safe-b));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 操作条两行时实际高约 196rpx（次操作 72 + 12 + 主操作 88 + 上下 padding 24），
   比 token --v4-inset-bar（160rpx+safe）高——撤销条上抬一档避免压住主操作。 */
.undo-bar-above-actions {
  bottom: calc(var(--v4-inset-bar) + 48rpx);
}

/* 面板遮罩：全屏遮罩把 safe-area 让给底部面板（面板自身只留内容内边距，避免双层安全区叠加）
   2026-11-08：z-index 20 < bottom-bar 600 ⇒ 操作条盖在补码浮层上（用户截图：柜号/尾号被截断）。
   遮罩必须高于操作条（600），否则面板永远被压住；面板再加 max-height + 滚动，字段多时长内容不被裁。 */
.panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 700;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 24rpx;
  background: var(--v4-card);
  border-radius: 24rpx 24rpx 0 0;
}

.panel-textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--v4-bg);
  font-size: 28rpx;
}

.panel-actions {
  justify-content: flex-end;
  margin-top: 20rpx;
}

.panel-actions .mini-btn {
  margin-left: 16rpx;
}

.picker-value {
  min-height: 40rpx;
}

.status-sub {
  margin-top: 12rpx;
}

.guest-chip {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.customer-no-line {
  margin-top: 12rpx;
}

.auto-hint {
  margin-top: 8rpx;
  color: var(--v4-partner);
}

.voucher-no {
  margin-top: 12rpx;
}

.voucher-footer {
  display: block;
  margin-top: 12rpx;
  color: var(--v4-text-4);
}

.error-text {
  margin-top: 12rpx;
  color: #D93026;
  font-size: 26rpx;
  font-size: calc(26rpx * var(--v4-fs-scale, 1));
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.reason-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid #E3E5E9;
  border-radius: 999rpx;
  background: #FAFBFC;
  font-size: 26rpx;
}

.reason-chip-active {
  border-color: var(--v4-brand);
  background: #E8F5F0;
  color: var(--v4-brand);
}

.quick-title {
  margin-top: 16rpx;
}

.parcel-block {
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.parcel-block:last-child {
  border-bottom: none;
}

/* D47 预约「最晚可接受时间」：到点未送达行内标红（纯展示，不自动取消） */
.appoint-overdue {
  color: var(--v4-danger, var(--v4-danger));
}

/* D61：逐件已取状态与独立按钮（已取件 / 撤销已取） */
.picked-summary-tag {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.tag-picked {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.tag-pending {
  background: var(--v4-fill);
  color: var(--v4-text-2);
}

.parcel-ops {
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.piece-action-btn {
  margin-right: 16rpx;
}

/* D58 转派区块：发起入口 / 邀请卡 / 等待卡 / 结果态（数据全来自 DTO，样式只做视觉分组） */
.transfer-card {
  border: 1rpx solid #D8E3FA;
}

/* D91：发起者「已转出」状态条（醒目但不刺眼；说明仍有操作权） */
.transfer-away {
  background: #FFF6E5;
  border-radius: 10rpx;
  color: #8A5A00;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
  padding: 14rpx 18rpx;
}

.transfer-request,
.transfer-invite,
.transfer-waiting,
.transfer-result {
  padding: 8rpx 0;
}

.transfer-invite,
.transfer-waiting {
  border-top: 1rpx solid var(--v4-line);
  margin-top: 12rpx;
  padding-top: 20rpx;
}

.transfer-remain {
  color: var(--v4-warning-text);
  margin-top: 6rpx;
}

.transfer-hint {
  color: var(--v4-text-4);
  margin-top: 6rpx;
}

.transfer-actions {
  justify-content: flex-end;
  margin-top: 16rpx;
}

.transfer-actions .mini-btn {
  margin-left: 16rpx;
}

/* D87-a/b 转派候选：搜索行 + 文字卡片（选中态高亮；无头像位，靠标题与状态两行可辨） */
.transfer-search {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.transfer-search-input {
  flex: 1;
}

.transfer-cards {
  margin-top: 12rpx;
}

.transfer-card-item {
  border: 1rpx solid #E3E8F0;
  border-radius: 12rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
}

.transfer-card-item.is-picked {
  border-color: #1F6F4A;
  background: #F3FAF6;
}

.transfer-card-title {
  font-size: 28rpx;
  color: #1F2329;
}

.transfer-card-meta {
  color: var(--v4-text-4);
  margin-top: 4rpx;
}

.transfer-empty {
  color: var(--v4-text-4);
  margin-top: 16rpx;
}

/* D88 转派码：编号行下方的输码行（6 位码，等宽可读） */.transfer-code-row {
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.transfer-code-tip {
  color: var(--v4-text-4);
  margin-top: 8rpx;
}

/* pkg-partner/pages/order-detail/index.wxss · 订单详情局部样式 */
.head-card {
  padding-bottom: 16rpx;
}

.order-no {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.copy-btn {
  min-height: 56rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.guest-row {
  margin-top: 16rpx;
}

.guest-tag {
  margin: 0 12rpx;
  background: #E8F0FF;
  color: #2B6DE5;
}

.counterpart {
  margin-top: 20rpx;
}

.counterpart-main {
  margin-left: 16rpx;
}

.flag-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF4CE;
  color: #8A6D00;
  font-size: 26rpx;
}

.image-row {
  margin-top: 16rpx;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.event-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.event-time {
  width: 100rpx;
  flex-shrink: 0;
}

.event-label {
  flex: 1;
}

.message-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

/* D65：操作条固定底盘/env 底垫由 components/bottom-bar 统一提供，本文件只保留条内按钮布局 */
.action-btn {
  flex: 1;
  margin: 0 8rpx;
}

/* 撤销条：token 组合定位；操作条同时存在时上抬一档，不互相遮挡 */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + var(--v4-safe-b));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
}

.undo-bar-above-actions {
  bottom: calc(var(--v4-inset-bar) + 16rpx);
}

/* 面板遮罩：全屏遮罩把 safe-area 让给底部面板（面板自身只留内容内边距，避免双层安全区叠加） */
.panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
}

.panel-textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  font-size: 28rpx;
}

.panel-actions {
  justify-content: flex-end;
  margin-top: 20rpx;
}

.panel-actions .mini-btn {
  margin-left: 16rpx;
}

.picker-value {
  min-height: 40rpx;
}

.status-sub {
  margin-top: 12rpx;
}

.guest-chip {
  background: #E8F0FF;
  color: #2B6DE5;
}

.customer-no-line {
  margin-top: 12rpx;
}

.auto-hint {
  margin-top: 8rpx;
  color: #2B6DE5;
}

.voucher-no {
  margin-top: 12rpx;
}

.voucher-footer {
  display: block;
  margin-top: 12rpx;
  color: #8A8F99;
}

.error-text {
  margin-top: 12rpx;
  color: #D93026;
  font-size: 26rpx;
}

.reason-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.reason-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid #E3E5E9;
  border-radius: 999rpx;
  background: #FAFBFC;
  font-size: 26rpx;
}

.reason-chip-active {
  border-color: #1F7A5C;
  background: #E8F5F0;
  color: #1F7A5C;
}

.quick-title {
  margin-top: 16rpx;
}

.parcel-block {
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.parcel-block:last-child {
  border-bottom: none;
}

/* D47 预约「最晚可接受时间」：到点未送达行内标红（纯展示，不自动取消） */
.appoint-overdue {
  color: var(--v4-danger, #E54545);
}

/* D61：逐件已取状态与独立按钮（已取件 / 撤销已取） */
.picked-summary-tag {
  background: #E8F0FF;
  color: #2B6DE5;
}

.tag-picked {
  background: #E8F0FF;
  color: #2B6DE5;
}

.tag-pending {
  background: #F0F2F5;
  color: #666666;
}

.parcel-ops {
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.piece-action-btn {
  margin-right: 16rpx;
}

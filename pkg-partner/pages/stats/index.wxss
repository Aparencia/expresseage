/* pkg-partner/pages/stats/index.wxss · 单量统计局部样式 */
.range-tabs {
  padding: 8rpx 0 24rpx;
}

.range-tab {
  min-width: 120rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.range-tab-active {
  background: #2B6DE5;
  color: #FFFFFF;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-cell {
  width: 50%;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
}

.bars {
  display: flex;
  align-items: flex-end;
  height: 160rpx;
  padding: 16rpx 0;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar {
  width: 24rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #2B6DE5;
  margin-bottom: 8rpx;
}

.stat-note {
  margin-top: 8rpx;
}

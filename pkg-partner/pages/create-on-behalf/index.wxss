/* pkg-partner/pages/create-on-behalf/index.wxss · 代客下单局部样式 */
.step-row {
  padding: 8rpx 0 24rpx;
}

.step {
  flex: 1;
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: var(--v4-card);
  color: var(--v4-text-2);
  font-size: 26rpx;
  margin-right: 12rpx;
}

.step:last-child {
  margin-right: 0;
}

.step-active {
  background: var(--v4-partner);
  color: #FFFFFF;
}

.error-card {
  background: var(--v4-danger-weak);
  color: var(--v4-danger);
  font-size: 26rpx;
}

.picker-value {
  min-height: 40rpx;
  line-height: 1.4;
}

.mode-row {
  margin: 12rpx 0 16rpx;
}

.mode-tag {
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--v4-line-strong);
  color: var(--v4-text-2);
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.mode-tag-active {
  border-color: var(--v4-partner);
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.zone-row {
  flex-wrap: wrap;
  flex: 1;
}

.review-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--v4-readonly-text);
}

.ai-row {
  margin-top: 16rpx;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.guest-note,
.submit-note {
  display: block;
  margin-top: 16rpx;
}

.item-card {
  border: 2rpx solid var(--v4-test-bg);
}

.item-head {
  margin-bottom: 8rpx;
}

.item-head-actions {
  align-items: center;
}

.picker-placeholder {
  color: var(--v4-text-3, var(--v4-text-3));
}

.service-desc {
  display: block;
  margin: -4rpx 0 16rpx;
  color: var(--v4-text-2);
}

.recognize-row {
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--v4-bg);
  border-radius: 12rpx;
}

.recognize-row .small {
  flex: 1;
  margin-right: 12rpx;
}

.remove-btn {
  padding: 8rpx 16rpx;
}

.add-item-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.nav-row {
  padding: 8rpx 0 24rpx;
}

.nav-btn {
  flex: 1;
  margin-right: 16rpx;
}

.nav-btn:last-child {
  margin-right: 0;
}

.warn-text {
  font-size: 26rpx;
  color: var(--v4-danger);
  margin-bottom: 12rpx;
}

.result-card {
  border: 2rpx solid var(--v4-brand);
}

.result-line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.result-order {
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 28rpx;
}

.duplicate-text {
  margin-top: 8rpx;
  color: var(--v4-readonly-text);
}

.hint-block {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--v4-bg);
  border-radius: 12rpx;
}

.hint-title {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.hint-line {
  display: block;
  line-height: 1.6;
}

.result-tip {
  margin-top: 12rpx;
}

.flag-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--v4-readonly-bg);
  color: var(--v4-readonly-text);
  font-size: 26rpx;
}

/* D47 预约「最晚可接受时间」：单选行 + 快捷时间胶囊（30 分钟粒度） */
.appoint-radio {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.appoint-note {
  margin: 4rpx 0 8rpx;
}

.preset-row {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.preset-chip {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--v4-brand);
  border-radius: 24rpx;
  color: var(--v4-brand);
  font-size: 26rpx;
}

/* D47 预约单选行与行内红字（页面级样式，与顾客下单页 radio-row 同构） */
.radio-row {
  display: flex;
  align-items: center;
  margin: 8rpx 24rpx 8rpx 0;
}

.error-text {
  color: var(--v4-danger, var(--v4-danger));
}

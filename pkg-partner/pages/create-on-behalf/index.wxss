/* pkg-partner/pages/create-on-behalf/index.wxss · 代客下单局部样式 */
.step-row {
  padding: 8rpx 0 24rpx;
}

.step {
  flex: 1;
  min-height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.step:last-child {
  margin-right: 0;
}

.step-active {
  background: #2B6DE5;
  color: #FFFFFF;
}

.error-card {
  background: #FDECEA;
  color: #E54D42;
  font-size: 26rpx;
}

.picker-value {
  min-height: 40rpx;
  line-height: 1.4;
}

.mode-row {
  margin: 12rpx 0 16rpx;
}

.mode-tag {
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  border: 2rpx solid #D9DEE5;
  color: #666666;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
}

.mode-tag-active {
  border-color: #2B6DE5;
  background: #E8F0FF;
  color: #2B6DE5;
}

.zone-row {
  flex-wrap: wrap;
  flex: 1;
}

.review-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8A6D00;
}

.ai-row {
  margin-top: 16rpx;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.guest-note,
.submit-note {
  display: block;
  margin-top: 16rpx;
}

.item-card {
  border: 2rpx solid #E8F0FF;
}

.item-head {
  margin-bottom: 8rpx;
}

.remove-btn {
  padding: 8rpx 16rpx;
}

.add-item-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.nav-row {
  padding: 8rpx 0 24rpx;
}

.nav-btn {
  flex: 1;
  margin-right: 16rpx;
}

.nav-btn:last-child {
  margin-right: 0;
}

.warn-text {
  font-size: 26rpx;
  color: #E54D42;
  margin-bottom: 12rpx;
}

.result-card {
  border: 2rpx solid #1F7A5C;
}

.result-line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.result-order {
  font-family: Menlo, Consolas, "Courier New", monospace;
  font-size: 28rpx;
}

.duplicate-text {
  margin-top: 8rpx;
  color: #8A6D00;
}

.hint-block {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F6F7F9;
  border-radius: 12rpx;
}

.hint-title {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.hint-line {
  display: block;
  line-height: 1.6;
}

.result-tip {
  margin-top: 12rpx;
}

.flag-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #FFF4CE;
  color: #8A6D00;
  font-size: 26rpx;
}

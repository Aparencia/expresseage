/* pkg-partner/pages/review/index.wxss · 审核核对页局部样式 */
.review-hint {
  margin: 8rpx 0 16rpx;
}

.review-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.review-row:last-child {
  border-bottom: none;
}

.review-no {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.review-meta {
  margin-top: 6rpx;
}

.review-empty {
  padding: 24rpx 0 8rpx;
}

.review-head {
  padding: 8rpx 0 16rpx;
}

.shot-swiper {
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background: var(--v4-bg);
  border-radius: 12rpx;
}

.shot-image {
  width: 100%;
  height: 100%;
}

.parcel-card {
  margin-top: 16rpx;
}

.need-tag {
  background: #FFF4CE;
  color: #8A6D00;
}

.parcel-actions {
  justify-content: flex-end;
  margin-top: 16rpx;
}

/* D92：审核状态 chip（未审核/已审核；颜色由文字承担，不靠图形） */
.review-tag {
  margin-right: 12rpx;
  color: #1F6F4A;
  background: #F1F8F4;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 24rpx;
}

.error-text {
  margin-top: 12rpx;
  color: #D93026;
  font-size: 26rpx;
  font-size: calc(26rpx * var(--v4-fs-scale, 1));
}

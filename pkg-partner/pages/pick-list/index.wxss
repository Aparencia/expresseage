/* pkg-partner/pages/pick-list/index.wxss · 取件清单局部样式（阶段 chip + 站点/楼层分组卡片 + 多选 + 底部批量条） */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.stage-chips {
  display: flex;
  padding: 0 0 16rpx;
}

.chip {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-active {
  background: #2B6DE5;
  color: #FFFFFF;
}

.copy-group-btn,
.copy-row-btn {
  margin-left: 16rpx;
  flex: none;
}

.copy-btn {
  margin-left: 12rpx;
}

.intro-card {
  padding: 24rpx;
}

.intro-text {
  line-height: 1.6;
}

.intro-summary {
  color: #1F7A5C;
  margin-top: 8rpx;
}

.intro-loaded {
  color: #8A6D00;
  margin-top: 8rpx;
}

.readonly-tip {
  color: #8A6D00;
  margin-top: 8rpx;
}

.test-tip {
  color: #2B6DE5;
  margin-top: 8rpx;
}

.loading-text {
  padding: 48rpx 0;
  text-align: center;
}

.floor-card {
  padding: 0 24rpx 8rpx;
  margin-top: 24rpx;
}

.floor-head {
  padding: 24rpx 0 16rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.floor-title {
  font-size: 32rpx;
}

.order-line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.order-line:last-child {
  border-bottom: none;
}

.order-line-active {
  background: #F0F7F4;
}

.check-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C9D2DC;
  margin-right: 16rpx;
  flex: none;
}

.check-dot-on {
  background: #1F7A5C;
  border-color: #1F7A5C;
}

.line-main {
  min-width: 0;
}

.line-top {
  align-items: center;
}

.room-text {
  font-size: 34rpx;
  margin-right: 12rpx;
}

.room-tag {
  background: #E8F0FF;
  color: #2B6DE5;
  margin-right: 12rpx;
}

.parcel-count {
  color: #666666;
}

.piece-line {
  margin-top: 4rpx;
  color: #333333;
}

.piece-station {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #FFF4E5;
  color: #B25E00;
  font-size: 22rpx;
}

.line-foot {
  margin-top: 8rpx;
}

.deliver-btn {
  margin-left: 16rpx;
  flex: none;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 32rpx;
}

/* D65：批量条固定底盘/env 底垫由 components/bottom-bar 统一提供，本文件只保留条内布局 */
.batch-head {
  margin-bottom: 16rpx;
}

.batch-fail {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #FFF4E5;
}

.batch-fail-text {
  color: #B25E00;
}

.batch-actions {
  display: flex;
}

.batch-btn {
  flex: 1;
}

.batch-tip {
  color: #2B6DE5;
  margin-top: 8rpx;
}

/* D61/D62：件级取件行（每件已取状态 + 独立按钮；行内只列本站件） */
.piece-line--pick {
  align-items: center;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.piece-text {
  font-family: Menlo, Consolas, monospace;
  font-size: 30rpx;
  color: #1F2937;
  margin-right: 12rpx;
}

.piece-text--picked {
  color: #8A8F99;
  text-decoration: line-through;
}

.piece-picked {
  background: #E8F0FF;
  color: #2B6DE5;
  margin-right: 12rpx;
}

.picked-count-tag {
  background: #E8F0FF;
  color: #2B6DE5;
  margin-left: 12rpx;
}

.piece-btn {
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.piece-other {
  color: #8A6D00;
  padding: 4rpx 0;
}

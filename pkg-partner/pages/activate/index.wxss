/* pkg-partner/pages/activate/index.wxss · 激活页局部样式（全局工具类见 app.wxss） */
.activate-head {
  padding: 32rpx 8rpx 24rpx;
}

.code-input {
  letter-spacing: 2rpx;
}

.avatar-row {
  align-items: center;
}

/* 原生 button 默认 width:184px 会压过单类宽度；头像行内的按钮应随内容收缩 */
.avatar-row .avatar-btn {
  width: auto;
  flex-shrink: 0;
}

.avatar-btn {
  min-height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.avatar-line {
  align-items: center;
}

.avatar-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 20rpx;
  gap: 8rpx;
}

.avatar-skip {
  font-size: 24rpx;
  color: #2B6DE5;
  padding: 8rpx 0;
}

/* 激活成功结果块 */
.result-card {
  display: flex;
  flex-direction: column;
}

.result-head {
  align-items: center;
  margin-bottom: 24rpx;
}

.result-main {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.result-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.result-no {
  font-family: monospace;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1A1A1A;
  padding: 16rpx 0;
}

.result-hint {
  margin-bottom: 24rpx;
}

.result-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.agree-row {
  padding: 24rpx 0 8rpx;
}

.agree-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.error {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #FDECEA;
  color: #E54D42;
  font-size: 26rpx;
}

.submit {
  margin-top: 24rpx;
}

.contact {
  margin-top: 24rpx;
  text-align: center;
}

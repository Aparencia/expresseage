/* pkg-partner/pages/service-settings/index.wxss · 服务设置局部样式 */
.head-title {
  padding: 8rpx 0 24rpx;
}

.first-tip {
  background: var(--v4-readonly-bg);
}

.service-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

/* D41：已停用类型（历史 PICKUP_DOOR）灰显但保留可读，不可勾选 */
.service-row-disabled {
  opacity: 0.5;
}

.service-legacy-tip {
  margin-top: 8rpx;
}

.service-main {
  margin-left: 16rpx;
}

.zone-row {
  display: flex;
  flex-wrap: wrap;
}

.zone-tag {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--v4-line-strong);
  color: var(--v4-text-2);
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.zone-tag-active {
  border-color: var(--v4-partner);
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.zone-note {
  margin-top: 8rpx;
}

.error {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--v4-danger-weak);
  color: var(--v4-danger);
  font-size: 26rpx;
}

/* D88 转派码：等宽大字便于口头/截图传达，操作按钮靠右 */
.transfer-code-line {
  align-items: baseline;
  margin-top: 16rpx;
}

.transfer-code-value {
  font-size: 40rpx;
  letter-spacing: 6rpx;
}

.code-actions {
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 16rpx;
}

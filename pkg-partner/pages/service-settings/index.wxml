<!-- pkg-partner/pages/service-settings/index.wxml · 服务类型与范围（不含费用字段） -->
<view class="page-body">
  <switch-bar />
  <view class="title head-title">服务类型与范围</view>

  <view wx:if="{{first}}" class="card first-tip">
    <view class="strong">先配置服务类型与范围，顾客才能下单</view>
    <view class="small">服务只说明做什么，本程序不涉及任何费用收付。</view>
  </view>

  <view wx:if="{{loading}}" class="empty-text">加载中…</view>
  <view wx:elif="{{!services.length}}" class="card">
    <empty-state text="{{errorText || '服务设置没加载出来'}}" actionText="重试" bind:action="load" />
  </view>

  <block wx:else>
    <view class="card">
      <view class="row between form-row">
        <view>
          <view class="strong">接单开关</view>
          <view class="small">关闭后新顾客暂时不能下单，已接的订单不受影响</view>
        </view>
        <switch checked="{{acceptingOrders}}" disabled="{{readonly}}" bindchange="onAcceptingChange" />
      </view>
    </view>

    <view class="card">
      <view class="section-title">服务类型（启用 / 停用）</view>
      <view
        wx:for="{{services}}"
        wx:key="code"
        class="service-row {{item.legacy ? 'service-row-disabled' : ''}}"
        data-index="{{index}}"
        bindtap="onServiceToggle"
      >
        <checkbox checked="{{item.enabled}}" disabled="{{readonly || item.legacy}}" />
        <view class="flex-1 service-main">
          <view class="strong">{{item.name}}</view>
          <view class="small">{{item.desc}}</view>
        </view>
      </view>
      <view wx:if="{{hasLegacy}}" class="small service-legacy-tip">灰显的「送寝上门（已停用）」是历史类型，只用于历史订单展示，不能再启用。</view>
    </view>

    <view class="card">
      <view class="section-title">服务范围（苑级）</view>
      <view class="zone-row">
        <view
          wx:for="{{zones}}"
          wx:key="key"
          class="zone-tag {{item.selected ? 'zone-tag-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onZoneToggle"
        >{{item.label}}</view>
      </view>
      <view class="small zone-note">楼栋、每日上限、营业时间属 P1，本期不展示。</view>
    </view>

    <!-- D59：团队页入口（成员/子邀请码/名额在 pkg-partner/pages/team/index） -->
    <view class="card">
      <view class="row between" bindtap="goTeam">
        <view class="flex-1">
          <view class="strong">我的团队</view>
          <view class="small">发子邀请码给协作队员；顾客只绑定你本人，订单由你转派给队员</view>
        </view>
        <view class="muted">›</view>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="error">{{errorText}}</view>
    <button class="btn btn-primary btn-block" disabled="{{saving || readonly}}" bindtap="onSave">
      {{saving ? '保存中…' : '保存'}}
    </button>
  </block>
</view>

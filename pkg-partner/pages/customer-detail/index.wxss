/* pkg-partner/pages/customer-detail/index.wxss · 顾客详情局部样式 */
.head-card {
  padding-bottom: 16rpx;
}

/* D68：停用/注销顾客状态标签（文案由 utils/customer-view 单源给出） */
.status-tag {
  margin-left: 12rpx;
  background: rgba(178, 106, 0, 0.12);
  color: var(--v4-warn, var(--v4-warning-text));
}

.head-main {
  margin-left: 20rpx;
  min-width: 0;
}

.number-row {
  margin-top: 6rpx;
  color: var(--v4-partner);
}

.number-label {
  margin-right: 12rpx;
}

.mini-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.note-input {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  padding: 16rpx;
  background: var(--v4-bg);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.note-actions {
  justify-content: flex-end;
  margin-top: 16rpx;
}

.note-actions .mini-btn {
  margin-left: 16rpx;
}

.section-head {
  margin-bottom: 8rpx;
}

.day-head {
  padding: 16rpx 0 8rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.order-line {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.more-row {
  padding-top: 20rpx;
}

.unbind-card {
  background: var(--v4-card);
}

.lock-text {
  color: var(--v4-danger);
  margin-top: 12rpx;
}

.unbind-btn {
  margin-top: 20rpx;
}

.unbind-reason {
  margin-top: 12rpx;
  text-align: center;
}

.footer-id {
  padding: 8rpx 0 32rpx;
}

.footer-id .id-text {
  margin: 0 12rpx;
}

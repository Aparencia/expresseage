/* pkg-partner/pages/messages/index.wxss · 消息中心局部样式 */
.msg-head {
  padding: 8rpx 0 24rpx;
}

.mark-read {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.mark-read-disabled {
  color: #999999;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 16rpx;
}

.chip {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  border: 1rpx solid #EEEEEE;
}

.chip-active {
  background: #2B6DE5;
  border-color: #2B6DE5;
  color: #FFFFFF;
}

.msg-item {
  position: relative;
}

.msg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E54D42;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.msg-text {
  margin: 12rpx 0;
  word-break: break-all;
}

.msg-more {
  text-align: center;
  padding: 24rpx 0;
}

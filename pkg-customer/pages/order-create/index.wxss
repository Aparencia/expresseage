/* pkg-customer/pages/order-create/index.wxss */
.steps {
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.step-node {
  flex-direction: column;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #D9DEE5;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.current {
  background: var(--v4-customer);
}

.step-dot.done {
  background: var(--v4-brand);
}

.step-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--v4-text-3);
}

.upload-state {
  margin-top: 16rpx;
}

.fail-card {
  border-left: 8rpx solid var(--v4-warning);
}

.fail-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.actions-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-inline {
  flex: 1;
  min-height: 80rpx;
  font-size: 28rpx;
}

.page-actions {
  margin-bottom: 32rpx;
}

.item-head {
  margin-bottom: 8rpx;
}

.item-title {
  margin-left: 12rpx;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--v4-text-3);
  box-sizing: border-box;
}

.check-box.checked {
  background: var(--v4-brand);
  border-color: var(--v4-brand);
}

.placeholder {
  color: var(--v4-text-3);
}

.error-text {
  color: var(--v4-danger);
  margin-top: 8rpx;
}

.needs-code {
  margin-top: 8rpx;
  color: var(--v4-warning);
}

.radio-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  font-size: 28rpx;
}

.summary-row {
  padding: 12rpx 0;
}

.zero-money-note {
  margin-top: 16rpx;
}

.ocr-text {
  margin-top: 16rpx;
  word-break: break-all;
  max-height: 320rpx;
  overflow-y: auto;
}

.link-text {
  color: var(--v4-brand);
  min-height: 64rpx;
  display: flex;
  align-items: center;
}

/* 2026-11-08（D77）：附加服务 chip（本页无全局 .chip，必须就地定义，否则选中态不可见） */
.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid #E3E5E9;
  border-radius: 999rpx;
  background: #FAFBFC;
  color: #333333;
  font-size: 26rpx;
}

.chip-active {
  border-color: #1F7A5C;
  background: #E8F5F0;
  color: #1F7A5C;
}

/* v1.0 D23/D24/D25：多图多件工具条 / 手填入口 / 配送地址 */
.list-tools {
  align-items: center;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.manual-entry-row {
  margin-top: 16rpx;
}

.manual-entry-row + .small {
  margin-top: 8rpx;
}

/* v1.0 D29：低置信建议条（不自动写入，点「采纳建议」才写） */
.ai-suggestion {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F5F7FA;
}

.suggestion-title {
  color: var(--v4-brand);
  margin-bottom: 4rpx;
}

.suggestion-adopt {
  margin-top: 12rpx;
}

/* D47 预约「最晚可接受时间」：说明条 + 快捷时间胶囊（30 分钟粒度） */
.appoint-note {
  margin: 8rpx 0 4rpx;
}

.preset-row {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.preset-chip {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--v4-brand);
  border-radius: 24rpx;
  color: var(--v4-brand);
  font-size: 26rpx;
}

/* 2026-11-08（D77）：附加服务复选 chip */
.addon-row { flex-wrap: wrap; }
.addon-chip { margin: 0 12rpx 12rpx 0; }
.addon-hint { margin-top: 8rpx; }
/* D84：Step4 附加服务预览（零金额；只列做什么/说明） */
.addon-preview { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #EEF1F6; }
/* 2026-11-08：核对页截图入口吸顶（下滑时固定在顶部） */
.shot-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

/* 2026-11-08：站点+取件码一行、柜号+尾号一行（密度优化） */
.item-main {
  align-items: flex-end;
  margin-top: 8rpx;
}

.item-station {
  flex-shrink: 0;
  max-width: 40%;
}

.station-chip {
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  background: #F3F6FA;
  color: #1F2937;
  font-size: 26rpx;
}

.item-code {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.item-sub {
  margin-top: 10rpx;
}

.item-sub-field {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
  margin-right: 16rpx;
}

.item-sub-field:last-child {
  margin-right: 0;
}

.sub-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #666666;
  font-size: 26rpx;
}

.sub-input {
  flex: 1;
  min-width: 0;
}
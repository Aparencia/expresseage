/* pkg-customer/pages/order-create/index.wxss */
.steps {
  margin-bottom: 24rpx;
  background: var(--v4-card);
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.step-node {
  flex-direction: column;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--v4-line-strong);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot.current {
  background: var(--v4-customer);
}

.step-dot.done {
  background: var(--v4-brand);
}

.step-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--v4-text-3);
}

.upload-state {
  margin-top: 16rpx;
}

/* D97：有截图即可下单提示（说明可留空，不是错误态） */
.shot-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: var(--v4-success-weak);
}

.fail-card {
  border-left: 8rpx solid var(--v4-warning);
}

.fail-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.actions-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-inline {
  flex: 1;
  min-height: 80rpx;
  font-size: 28rpx;
}

/* 2026-11-19：主按钮常驻底部（UX §3.7「主按钮常驻底部」）；底垫由根节点 page-body--bar 预留（D65） */
.page-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  margin: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--v4-card);
  border-top: 1rpx solid var(--v4-line);
}

.item-title {
  margin-left: 12rpx;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--v4-text-3);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-box.checked {
  background: var(--v4-brand);
  border-color: var(--v4-brand);
}

.check-mark {
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1;
}

.placeholder {
  color: var(--v4-text-3);
}

.error-text {
  color: var(--v4-danger);
  margin-top: 8rpx;
}

.needs-code {
  margin-top: 8rpx;
  color: var(--v4-warning);
}

.radio-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 72rpx;
  font-size: 28rpx;
}

.summary-row {
  padding: 12rpx 0;
}

.zero-money-note {
  margin-top: 16rpx;
}

.ocr-text {
  margin-top: 16rpx;
  word-break: break-all;
  max-height: 320rpx;
  overflow-y: auto;
}

.link-text {
  color: var(--v4-brand);
  min-height: 64rpx;
  display: flex;
  align-items: center;
}

/* 2026-11-08（D77）：附加服务 chip（本页无全局 .chip，必须就地定义，否则选中态不可见） */
.chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid #E3E5E9;
  border-radius: 999rpx;
  background: #FAFBFC;
  color: var(--v4-text);
  font-size: 26rpx;
}

.chip-active {
  border-color: var(--v4-brand);
  background: #E8F5F0;
  color: var(--v4-brand);
}

/* v1.0 D23/D24/D25：多图多件工具条 / 手填入口 / 配送地址 */
/* 2026-11-19：工具条改为「左：全选 / 右：进度 + 加件」；加件不再 flex:1 撑满整行 */
.list-tools {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.tools-left {
  flex-shrink: 0;
}

.tools-left-text {
  margin-left: 12rpx;
}

.tools-right {
  gap: 16rpx;
}

.tools-add {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.manual-entry-row {
  margin-top: 16rpx;
}

.manual-entry-row + .small {
  margin-top: 8rpx;
}

/* v1.0 D29：低置信建议条（不自动写入，点「采纳建议」才写） */
.ai-suggestion {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F5F7FA;
}

.suggestion-title {
  color: var(--v4-brand);
  margin-bottom: 4rpx;
}

.suggestion-adopt {
  margin-top: 12rpx;
}

/* D47 预约「最晚可接受时间」：说明条 + 快捷时间胶囊（30 分钟粒度） */
.appoint-note {
  margin: 8rpx 0 4rpx;
}

.preset-row {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.preset-chip {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--v4-brand);
  border-radius: 24rpx;
  color: var(--v4-brand);
  font-size: 26rpx;
}

/* 2026-11-08（D77）：附加服务复选 chip */
.addon-row { flex-wrap: wrap; }
.addon-chip { margin: 0 12rpx 12rpx 0; }
.addon-hint { margin-top: 8rpx; }
/* D84：Step4 附加服务预览（零金额；只列做什么/说明） */
.addon-preview { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid var(--v4-fill); }
/* 2026-11-08：核对页截图入口吸顶（下滑时固定在顶部） */
.shot-sticky {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 16rpx 24rpx;
  background: var(--v4-card);
  border-bottom: 1rpx solid var(--v4-line);
}

/* 2026-11-19：字段标签统一在控件上方、控件同高（80rpx），站点列 40% / 取件码列 60%；
   柜号+尾号同排；红字紧跟所在行，解决「标签漂移 / 输入框看不见 / 报错离字段太远」 */
.item-card {
  padding-bottom: 20rpx;
}

.item-head {
  margin-bottom: 16rpx;
}

.item-head-main {
  flex: 1;
  min-width: 0;
}

.item-source {
  margin-left: 12rpx;
}

.item-remove {
  flex-shrink: 0;
  min-height: 64rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  color: var(--v4-text-3);
  font-size: 26rpx;
}

.item-main {
  align-items: flex-start;
  margin-top: 0;
}

.item-field {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-field--station {
  width: 40%;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.item-field--code {
  flex: 1;
  min-width: 0;
}

.item-field--half {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.item-field--last {
  margin-right: 0;
}

/* 字段标签沿用全局 form-label 同构，但收窄宽度/字号以适配两列布局 */
.item-field .form-label {
  width: auto;
  font-size: 24rpx;
  color: var(--v4-text-3);
  margin-bottom: 8rpx;
}

.item-station {
  width: 100%;
}

.station-chip {
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: var(--v4-bg);
  color: var(--v4-text);
  font-size: 26rpx;
  box-sizing: border-box;
}

.station-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chevron {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #8A93A0;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.code-field {
  display: block;
  width: 100%;
}

.item-sub {
  align-items: flex-start;
  margin-top: 16rpx;
}

.item-errors {
  margin-top: 8rpx;
}

.sub-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: var(--v4-bg);
  font-size: 28rpx;
  box-sizing: border-box;
}

<view class="page-body">
  <switch-bar />

  <view class="steps row">
    <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="step-node flex-1 center">
      <view class="step-dot {{step > item ? 'done' : (step === item ? 'current' : '')}}">{{item}}</view>
      <view class="step-label">{{item === 1 ? '截图' : (item === 2 ? '核对' : (item === 3 ? '服务/地址' : '提交'))}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{readonly}}">
    <view class="muted">开发者只读视角不能操作。</view>
  </view>

  <view class="card" wx:if="{{!profileReady || !bindingReady}}">
    <view class="muted">资料完整且已绑定兼职后才能下单。</view>
  </view>

  <block wx:if="{{step === 1}}">
    <view class="card">
      <view class="section-title">上传取件码截图（0~{{maxImages}} 张）</view>
      <view class="muted">可一次多选，也可分几次添加；多张截图会合并成同一张订单。截图仅用于识别取件码与兼职核对；订单完成或取消后 7 天删除。</view>
      <image-picker purpose="TICKET" max-count="{{maxImages}}" disabled="{{readonly}}" bind:change="onPickFile" bind:error="onPickError" bind:limit="onPickLimit" />
      <view class="muted upload-state" wx:if="{{ocrState === 'upload'}}">正在上传…</view>
      <view class="muted upload-state" wx:if="{{ocrState === 'ocr'}}">正在识别截图里的取件码…（通常 3~10 秒）</view>
      <view class="muted upload-state" wx:if="{{ocrState === 'ai'}}">正在智能识别…（最多 8 秒）</view>
      <!-- §4.3.1 ③：兜底中可「取消」/「先手动填写」（不阻塞手填；之后迟到的建议不再覆盖） -->
      <view class="actions-row" wx:if="{{ocrState === 'ai'}}">
        <button class="btn btn-ghost btn-inline" bindtap="onCancelAi">取消</button>
        <button class="btn btn-primary btn-inline" bindtap="onManualTap">先手动填写</button>
      </view>
      <view class="actions-row" wx:if="{{ocrState === 'ocr'}}">
        <button class="btn btn-ghost btn-inline" bindtap="onManualTap">先手动填写</button>
      </view>
      <view class="actions-row" wx:if="{{ocrText}}">
        <button class="btn btn-ghost btn-inline" bindtap="onToggleOcrText">{{ocrTextOpen ? '收起识别原文' : '查看识别原文（仅本页显示，不会保存）'}}</button>
      </view>
      <view class="muted small ocr-text" wx:if="{{ocrText && ocrTextOpen}}">{{ocrText}}</view>
      <!-- D24：不传截图直接手填（不进入识别链路、不调 AI、不写复核队列） -->
      <view class="actions-row manual-entry-row">
        <button class="btn btn-ghost btn-block" bindtap="onManualOnlyTap">不传截图，手动填写</button>
      </view>
      <view class="muted small">没有截图也能提交；有截图识别更快，兼职也更好核对。</view>
    </view>

    <!-- 点击查看截图（§4.8；本地预览，不新增上传、不出现 wx.cloud.*） -->
    <view class="card" wx:if="{{files.length}}">
      <view class="small link-text" bindtap="onPreviewImage">点击查看截图（{{files.length}} 张）</view>
    </view>

    <view class="card fail-card" wx:if="{{ocrState === 'failed' && failureText}}">
      <view class="fail-title">{{failureText}}</view>
      <view class="muted">{{failureNext}}</view>
      <view class="muted" wx:if="{{ocrError}}">{{ocrError}}</view>
      <view class="actions-row">
        <button class="btn btn-ghost btn-inline" bindtap="onManualTap">手动填写</button>
        <button class="btn btn-primary btn-inline" bindtap="onRetryOcr">重新识别</button>
      </view>
    </view>
  </block>

  <block wx:if="{{step === 2}}">
    <view class="card" wx:if="{{recognizeHint || aiHint || imageFailures.length}}">
      <view class="small error-text" wx:if="{{recognizeHint}}">{{recognizeHint}}</view>
      <view class="small" wx:if="{{aiHint}}">{{aiHint}}</view>
      <view class="small" wx:for="{{imageFailures}}" wx:key="imageIndex">{{item.copy.text}}（第 {{item.imageIndex + 1}} 张图）</view>
    </view>
    <view class="card" wx:if="{{files.length}}">
      <view class="small link-text" bindtap="onPreviewImage">点击查看截图（{{files.length}} 张）</view>
    </view>

    <view class="card row between list-tools">
      <view class="row" bindtap="onToggleAll">
        <view class="check-box {{items.length && items[0].checked ? 'checked' : ''}}"></view>
        <view class="small">全选</view>
      </view>
      <view class="small muted">已填 {{items.length}}/{{maxParcels}} 件</view>
      <button class="btn btn-ghost btn-inline" bindtap="onAddItem">加一件</button>
    </view>

    <view class="card" wx:for="{{items}}" wx:key="key">
      <view class="row between item-head">
        <view class="row" data-index="{{index}}" bindtap="onItemToggle">
          <view class="check-box {{item.checked ? 'checked' : ''}}"></view>
          <view class="strong item-title">第 {{index + 1}} 件</view>
          <view class="small muted" wx:if="{{item.imageIndex >= 0}}">来自第 {{item.imageIndex + 1}} 张图</view>
        </view>
        <view class="small" data-index="{{index}}" bindtap="onRemoveItem">移除</view>
      </view>

      <picker range="{{stations}}" range-key="name" data-index="{{index}}" bindchange="onStationChange">
        <view class="form-row">
          <view class="form-label">站点</view>
          <view class="form-input {{item.stationName ? '' : 'placeholder'}}">{{item.stationName || '请选择驿站站点'}}</view>
        </view>
      </picker>

      <code-editor
        value="{{item.pickupCode}}"
        placeholder="取件码（可留空，填运单后 5 位）"
        maxlength="40"
        data-index="{{index}}"
        bind:change="onCodeChange"
      />

      <view class="form-row">
        <view class="form-label">柜号</view>
        <input class="form-input" value="{{item.lockerNo}}" placeholder="选填，≤10 字" maxlength="10" data-index="{{index}}" bindinput="onLockerChange" />
      </view>
      <view class="form-row">
        <view class="form-label">运单尾号</view>
        <input class="form-input" value="{{item.trackingTail}}" placeholder="选填，后 5 位数字" maxlength="5" data-index="{{index}}" bindinput="onTailChange" />
      </view>

      <view class="small error-text" wx:if="{{item.formErrors.station}}">{{item.formErrors.station}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.pickupCode}}">{{item.formErrors.pickupCode}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.lockerNo}}">{{item.formErrors.lockerNo}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.trackingTail}}">{{item.formErrors.trackingTail}}</view>
      <view class="small needs-code" wx:if="{{item.codeStatus === 'NEED_CODE'}}">需查明（兼职接单后帮你查码）</view>
      <view class="small muted" wx:if="{{item.aiHint}}">{{item.aiHint}}</view>

      <view class="ai-suggestion" wx:if="{{item.aiSuggestion}}">
        <view class="small suggestion-title">{{lowCopy.title}}</view>
        <view class="small muted">{{lowCopy.lowHint}}</view>
        <view class="small muted" wx:if="{{item.aiSuggestion.stationName}}">建议站点：{{item.aiSuggestion.stationName}}</view>
        <view class="small muted" wx:if="{{item.aiSuggestion.pickupCode}}">建议取件码：{{item.aiSuggestion.pickupCode}}</view>
        <view class="small muted" wx:if="{{item.aiSuggestion.trackingTail}}">建议尾号：{{item.aiSuggestion.trackingTail}}</view>
        <view class="small muted" wx:if="{{item.aiSuggestion.lockerNo}}">建议柜号：{{item.aiSuggestion.lockerNo}}</view>
        <button class="btn btn-ghost btn-inline suggestion-adopt" data-index="{{index}}" bindtap="onAdoptSuggestion" disabled="{{readonly}}">{{lowCopy.adopt}}</button>
      </view>
    </view>

    <view class="actions-row page-actions">
      <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
      <button class="btn btn-primary btn-inline" bindtap="goStep2Next">下一步：服务与地址</button>
    </view>
  </block>

  <block wx:if="{{step === 3}}">
    <view class="card">
      <view class="section-title">服务类型（整单一份）</view>
      <picker range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="onServiceChange">
        <view class="form-row">
          <view class="form-label">服务类型</view>
          <view class="form-input">{{services[serviceIndex].name || '请选择服务类型'}}</view>
        </view>
      </picker>
      <!-- 只显示名称与说明（D6/§3.7：零金额语义） -->
      <view class="small muted service-desc" wx:if="{{services[serviceIndex].desc}}">{{services[serviceIndex].desc}}</view>
    </view>

    <view class="card">
      <view class="section-title">预约与备注（整单一份）</view>
      <radio-group bindchange="onAppointType">
        <label class="radio-row"><radio value="ASAP" checked="{{appointType === 'ASAP'}}" />尽快</label>
        <label class="radio-row"><radio value="SLOT" checked="{{appointType === 'SLOT'}}" />预约时段</label>
      </radio-group>
      <picker wx:if="{{appointType === 'SLOT'}}" range="{{slots}}" range-key="label" bindchange="onSlotChange">
        <view class="form-row">
          <view class="form-label">时段</view>
          <view class="form-input">{{slots[slotIndex].label || '请选择预约时段'}}</view>
        </view>
      </picker>
      <view class="form-row">
        <view class="form-label">备注</view>
        <input class="form-input" value="{{note}}" placeholder="给兼职的话（≤200 字）" maxlength="200" bindinput="onNoteInput" />
      </view>
    </view>

    <view class="card">
      <view class="section-title">配送到哪（本单有效，不改资料）</view>
      <radio-group bindchange="onDeliveryModeChange">
        <label class="radio-row"><radio value="SELF" checked="{{delivery.mode === 'SELF'}}" />本人宿舍</label>
        <label class="radio-row"><radio value="OTHER" checked="{{delivery.mode === 'OTHER'}}" />送给别人</label>
      </radio-group>
      <view class="muted small" wx:if="{{delivery.mode === 'SELF'}}">{{deliverySelfText}}</view>
      <block wx:if="{{delivery.mode === 'OTHER'}}">
        <picker range="{{deliveryZones}}" range-key="label" bindchange="onDeliveryZoneChange">
          <view class="form-row">
            <view class="form-label">苑</view>
            <view class="form-input {{delivery.other.zone ? '' : 'placeholder'}}">{{delivery.other.zone ? deliveryText : '请选择苑'}}</view>
          </view>
        </picker>
        <picker range="{{deliveryBuildings}}" range-key="label" bindchange="onDeliveryBuildingChange">
          <view class="form-row">
            <view class="form-label">楼栋</view>
            <view class="form-input {{delivery.other.buildingNo ? '' : 'placeholder'}}">{{delivery.other.buildingNo ? delivery.other.buildingNo + ' 栋' : '请选择楼栋'}}</view>
          </view>
        </picker>
        <view class="form-row">
          <view class="form-label">宿舍号</view>
          <input class="form-input" value="{{delivery.other.room}}" placeholder="如 522（100 以上）" maxlength="8" bindinput="onDeliveryRoomInput" />
        </view>
        <view class="form-row">
          <view class="form-label">收件人称呼</view>
          <input class="form-input" value="{{delivery.other.recipientName}}" placeholder="选填，最多 20 字" maxlength="20" bindinput="onDeliveryNameInput" />
        </view>
        <view class="small error-text" wx:if="{{deliveryErrors.zone}}">{{deliveryErrors.zone}}</view>
        <view class="small error-text" wx:if="{{deliveryErrors.buildingNo}}">{{deliveryErrors.buildingNo}}</view>
        <view class="small error-text" wx:if="{{deliveryErrors.room}}">{{deliveryErrors.room}}</view>
        <view class="small error-text" wx:if="{{deliveryErrors.recipientName}}">{{deliveryErrors.recipientName}}</view>
        <view class="muted small">送达地址：{{deliveryText}}</view>
      </block>
    </view>

    <view class="actions-row page-actions">
      <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
      <button class="btn btn-primary btn-inline" bindtap="goStep3Next">下一步：确认提交</button>
    </view>
  </block>

  <block wx:if="{{step === 4}}">
    <block wx:if="{{resultOrderNo}}">
      <view class="card">
        <view class="section-title">{{resultMerged ? '已并入最近订单' : '已提交'}}</view>
        <view class="muted" wx:if="{{resultMerged}}">短时间内再次下单会自动并入同一订单，兼职只需接一次。</view>
        <view class="small">订单号：{{resultOrderNo}}</view>
        <view class="small" wx:if="{{resultMerged}}">本次包裹已追加到该订单，页面展示为合并后的全部包裹。</view>
        <view class="actions-row">
          <button class="btn btn-primary btn-inline" bindtap="onViewOrder">查看订单</button>
          <button class="btn btn-ghost btn-inline" bindtap="onBackHome">回首页</button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="card">
        <view class="section-title">确认订单（共 {{items.length}} 件）</view>
        <view wx:for="{{items}}" wx:key="key" class="summary-row" wx:if="{{item.checked}}">
          <view class="muted">{{item.stationName}} · {{item.pickupCode || '待查码'}}{{item.trackingTail ? ' · 尾号 ' + item.trackingTail : ''}}</view>
        </view>
        <view class="muted small">服务：{{services[serviceIndex].name || '未选'}} · 预约：{{appointType === 'SLOT' ? (slots[slotIndex].label || '预约时段') : '尽快'}}</view>
        <view class="muted small" wx:if="{{note}}">备注：{{note}}</view>
        <view class="muted small">送达：{{deliveryText}}</view>
        <view class="small link-text" wx:if="{{files.length}}" bindtap="onPreviewImage">点击查看截图（{{files.length}} 张）</view>
        <view class="small muted" wx:if="{{!files.length}}">本次未上传截图（手动填写）</view>
        <view class="muted zero-money-note">本程序不涉及任何费用收付</view>
      </view>

      <view class="card" wx:if="{{submitError}}">
        <view class="muted">{{submitError}}</view>
        <button class="btn btn-ghost btn-inline" bindtap="onRetrySubmit">重试</button>
      </view>

      <view class="actions-row page-actions">
        <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
        <button class="btn btn-primary btn-inline {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '正在提交…' : '提交订单'}}</button>
      </view>
    </block>
  </block>
</view>

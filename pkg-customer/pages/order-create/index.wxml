<view class="page-body">
  <switch-bar />

  <view class="steps row">
    <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="step-node flex-1 center">
      <view class="step-dot {{step > item ? 'done' : (step === item ? 'current' : '')}}">{{item}}</view>
      <view class="step-label">{{item === 1 ? '截图' : (item === 2 ? '核对' : (item === 3 ? '服务' : '提交'))}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{readonly}}">
    <view class="muted">开发者只读视角不能操作。</view>
  </view>

  <view class="card" wx:if="{{!profileReady || !bindingReady}}">
    <view class="muted">资料完整且已绑定兼职后才能下单。</view>
  </view>

  <block wx:if="{{step === 1}}">
    <view class="card">
      <view class="section-title">上传取件码截图</view>
      <view class="muted">截图仅用于识别取件码与兼职核对；订单完成或取消后 7 天删除。</view>
      <image-picker purpose="TICKET" max-count="1" bind:change="onPickFile" bind:error="onPickError" />
      <view class="muted upload-state" wx:if="{{ocrState === 'upload'}}">正在上传…</view>
      <view class="muted upload-state" wx:if="{{ocrState === 'ocr'}}">正在识别截图里的取件码…（通常 3~10 秒）</view>
      <view class="muted upload-state" wx:if="{{ocrState === 'ai'}}">正在智能识别，可继续手动填写…</view>
    </view>

    <view class="card fail-card" wx:if="{{ocrState === 'failed' && failureText}}">
      <view class="fail-title">{{failureText}}</view>
      <view class="muted">{{failureNext}}</view>
      <view class="muted" wx:if="{{ocrError}}">{{ocrError}}</view>
      <view class="actions-row">
        <button class="btn btn-ghost btn-inline" bindtap="onManualTap">手动填写</button>
        <button class="btn btn-primary btn-inline" bindtap="onRetryOcr">重新识别</button>
      </view>
    </view>
  </block>

  <block wx:if="{{step === 2}}">
    <view class="card" wx:if="{{recognizeHint}}">
      <view class="small error-text">{{recognizeHint}}</view>
    </view>
    <view class="card" wx:for="{{items}}" wx:key="key">
      <view class="row between item-head">
        <view class="row" data-index="{{index}}" bindtap="onItemToggle">
          <view class="check-box {{item.checked ? 'checked' : ''}}"></view>
          <view class="strong item-title">第 {{index + 1}} 件</view>
        </view>
        <view class="small" data-index="{{index}}" bindtap="onRemoveItem">移除</view>
      </view>

      <picker range="{{stations}}" range-key="name" data-index="{{index}}" bindchange="onStationChange">
        <view class="form-row">
          <view class="form-label">站点</view>
          <view class="form-input {{item.stationName ? '' : 'placeholder'}}">{{item.stationName || '请选择驿站站点'}}</view>
        </view>
      </picker>

      <code-editor
        value="{{item.pickupCode}}"
        placeholder="取件码（可留空，填运单后 5 位）"
        maxlength="40"
        data-index="{{index}}"
        bind:change="onCodeChange"
      />

      <view class="form-row">
        <view class="form-label">柜号</view>
        <input class="form-input" value="{{item.lockerNo}}" placeholder="选填，≤10 字" maxlength="10" data-index="{{index}}" bindinput="onLockerChange" />
      </view>
      <view class="form-row">
        <view class="form-label">运单尾号</view>
        <input class="form-input" value="{{item.trackingTail}}" placeholder="选填，后 5 位数字" maxlength="5" data-index="{{index}}" bindinput="onTailChange" />
      </view>

      <view class="small error-text" wx:if="{{item.formErrors.station}}">{{item.formErrors.station}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.pickupCode}}">{{item.formErrors.pickupCode}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.lockerNo}}">{{item.formErrors.lockerNo}}</view>
      <view class="small error-text" wx:if="{{item.formErrors.trackingTail}}">{{item.formErrors.trackingTail}}</view>
      <view class="small needs-code" wx:if="{{item.codeStatus === 'NEED_CODE'}}">需查明（兼职接单后帮你查码）</view>
    </view>

    <view class="card">
      <button class="btn btn-ghost btn-block" bindtap="onAddItem">手动加一件</button>
    </view>

    <view class="actions-row page-actions">
      <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
      <button class="btn btn-primary btn-inline" bindtap="goStep2Next">下一步：选服务类型</button>
    </view>
  </block>

  <block wx:if="{{step === 3}}">
    <view class="card" wx:for="{{items}}" wx:key="key" wx:if="{{item.checked}}">
      <view class="strong">第 {{index + 1}} 件 · {{item.stationName || '未选站点'}}</view>
      <picker range="{{services}}" range-key="name" data-index="{{index}}" value="{{item.serviceIndex || 0}}" bindchange="onServiceChange">
        <view class="form-row">
          <view class="form-label">服务类型</view>
          <view class="form-input">{{services[item.serviceIndex || 0].name || '请选择服务类型'}}</view>
        </view>
      </picker>
    </view>

    <view class="card">
      <view class="section-title">预约时间</view>
      <radio-group bindchange="onAppointType">
        <label class="radio-row"><radio value="ASAP" checked="{{appointType === 'ASAP'}}" />尽快</label>
        <label class="radio-row"><radio value="SLOT" checked="{{appointType === 'SLOT'}}" />预约时段</label>
      </radio-group>
      <picker wx:if="{{appointType === 'SLOT'}}" range="{{slots}}" range-key="label" bindchange="onSlotChange">
        <view class="form-row">
          <view class="form-label">时段</view>
          <view class="form-input">{{slots[slotIndex].label || '请选择预约时段'}}</view>
        </view>
      </picker>
      <view class="form-row">
        <view class="form-label">备注</view>
        <input class="form-input" value="{{note}}" placeholder="给兼职的话（≤200 字）" maxlength="200" bindinput="onNoteInput" />
      </view>
    </view>

    <view class="actions-row page-actions">
      <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
      <button class="btn btn-primary btn-inline" bindtap="goStep3Next">下一步：确认提交</button>
    </view>
  </block>

  <block wx:if="{{step === 4}}">
    <block wx:if="{{resultBatch}}">
      <view class="card">
        <view class="section-title">已创建 {{resultOrders.length}} 张订单</view>
        <view wx:for="{{resultOrders}}" wx:key="orderNo" class="row between result-row" data-order-no="{{item.orderNo}}" bindtap="onViewOrder">
          <view class="muted">{{item.orderNo}}</view>
          <view class="small">查看订单</view>
        </view>
        <button class="btn btn-primary btn-block" bindtap="onBackHome">回首页</button>
      </view>
    </block>

    <block wx:else>
      <view class="card">
        <view class="section-title">确认订单（共 {{items.length}} 件）</view>
        <view wx:for="{{items}}" wx:key="key" class="summary-row" wx:if="{{item.checked}}">
          <view class="muted">{{item.stationName}} · {{item.pickupCode || '待查码'}} · {{services[item.serviceIndex || 0].name}}</view>
        </view>
        <view class="muted">预约：{{appointType === 'ASAP' ? '尽快' : slots[slotIndex].label}}</view>
        <view class="muted" wx:if="{{note}}">备注：{{note}}</view>
        <view class="muted zero-money-note">本程序不涉及任何费用收付</view>
      </view>

      <view class="card" wx:if="{{submitError}}">
        <view class="muted">{{submitError}}</view>
        <button class="btn btn-ghost btn-inline" bindtap="onRetrySubmit">重试</button>
      </view>

      <view class="actions-row page-actions">
        <button class="btn btn-ghost btn-inline" bindtap="goPrev">上一步</button>
        <button class="btn btn-primary btn-inline {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '正在提交…' : '提交订单'}}</button>
      </view>
    </block>
  </block>
</view>

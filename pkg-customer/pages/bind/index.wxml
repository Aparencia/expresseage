<view class="page-body">
  <switch-bar />

  <view class="card" wx:if="{{mode === 'rebind' && currentBinding}}">
    <view class="section-title">当前绑定</view>
    <view class="muted">解绑或换绑请到「我的」页操作；换绑仅限无进行中订单。</view>
    <room-tag-text dorm-key="{{currentBinding.dormKey}}" tag="{{currentBinding.roomTag}}" />
  </view>

  <view class="card">
    <view class="section-title">输入完整兼职编号</view>
    <view class="muted">向兼职要完整编号（P 开头，如 P-7K2-M9X），每天最多尝试 5 次。</view>
    <view class="form-row">
      <input
        class="form-input"
        value="{{input}}"
        placeholder="输入完整兼职编号，如 P-7K2-M9X"
        maxlength="20"
        bindinput="onInput"
      />
    </view>
    <view class="row bind-actions">
      <button class="btn btn-ghost btn-half" bindtap="onPaste">粘贴</button>
      <button class="btn btn-primary btn-half" bindtap="onQuery">{{loading ? '查询中…' : '查询'}}</button>
    </view>
    <view class="small hint-text" wx:if="{{hint}}">{{hint}}</view>
    <view class="small error-text" wx:if="{{error}}">{{error}}</view>
  </view>

  <view class="card" wx:if="{{preview}}">
    <view class="section-title">确认绑定这位兼职？</view>
    <view class="row">
      <view class="col flex-1">
        <view class="strong">{{preview.displayName}}</view>
        <id-text kind="PARTNER" no="{{preview.partnerNo}}" />
      </view>
    </view>
    <view class="muted">服务类型：{{servicesText}}</view>
    <view class="muted">服务范围：{{zonesText}}</view>
    <view class="muted" wx:if="{{!preview.acceptingOrders}}">这位兼职暂停接单，绑定后暂时不能下单。</view>
    <button class="btn btn-primary btn-block" bindtap="onConfirm">{{submitting ? '绑定中…' : '确认绑定'}}</button>
  </view>

  <view class="card" wx:if="{{roomTag}}">
    <view class="section-title">绑定成功</view>
    <view class="muted">已绑定「{{boundName}}」，同寝室标识已分配：</view>
    <room-tag-text dorm-key="" tag="{{roomTag}}" />
    <button class="btn btn-ghost btn-block" bindtap="onOpenProfile">回「我的」</button>
  </view>

  <view class="empty-text" wx:if="{{boundName}}">正在进入首页…</view>
  <view class="muted bind-tip">绑定只能由顾客发起；兼职不能绑定或导入顾客。</view>
</view>

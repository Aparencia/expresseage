/* pkg-customer/pages/order-detail/index.wxss */
.status-title {
  margin: 16rpx 0 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.order-no-row {
  gap: 16rpx;
}

.copy-link {
  color: var(--v4-brand);
  padding: 4rpx 8rpx;
}

.last-updated {
  margin: 0 8rpx 16rpx;
}

.error-bar {
  border-left: 6rpx solid var(--v4-warning);
}

.notice-bar {
  background: #FFF8E6;
}

.notice-text {
  color: var(--v4-readonly-text);
}

.progress {
  margin-top: 24rpx;
}

.progress-step {
  flex-direction: column;
}

.progress-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #D9DEE5;
  margin-bottom: 8rpx;
}

.progress-dot.done {
  background: var(--v4-brand);
}

.progress-dot.current {
  background: var(--v4-customer);
}

.progress-dot.exception {
  background: var(--v4-danger);
}

.progress-dot.cancelled {
  background: #C9CED6;
}

.progress-label {
  font-size: 22rpx;
  color: var(--v4-text-3);
}

.progress-label.current {
  color: var(--v4-customer);
  font-weight: 600;
}

.progress-label.done {
  color: var(--v4-brand);
}

.progress-label.exception {
  color: var(--v4-danger);
  font-weight: 600;
}

.progress-label.cancelled {
  color: var(--v4-text-3);
}

.progress-branch {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: var(--v4-line);
}

.progress-branch.exception {
  background: #FDECEA;
}

.progress-branch.cancelled {
  background: #F0F2F5;
}

.branch-label {
  margin-bottom: 4rpx;
}

.order-section .line {
  min-height: 72rpx;
}

.right {
  text-align: right;
}

.counterpart-meta {
  margin-left: 20rpx;
}

.id-line {
  margin-top: 20rpx;
  gap: 20rpx;
}

.actions .btn {
  margin-bottom: 20rpx;
}

.cancel-guide {
  margin-top: 8rpx;
  line-height: 1.5;
}

.exception-card {
  background: #FDECEA;
}

.image-note {
  max-width: 420rpx;
  text-align: right;
}

.message-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.message-mine {
  text-align: right;
}

.message-text {
  font-size: 28rpx;
}

.message-input-row {
  margin-top: 20rpx;
  gap: 16rpx;
}

.archive-note {
  margin-top: 12rpx;
}

.event-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.event-time {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.event-text {
  font-size: 26rpx;
  color: var(--v4-text-2);
  line-height: 1.5;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

/* v1.0（D23/D24/D25）：多包裹 / 无截图·手填标识 / 多图入口 */
.parcel-block {
  border-bottom: 1rpx solid #F0F2F5;
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
}

.parcel-block:last-of-type {
  border-bottom: none;
}

.manual-badge {
  margin: 8rpx 0;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF7E6;
  color: #AD6800;
}

.image-actions {
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 8rpx;
}

.image-link {
  min-height: 56rpx;
}

.link-text {
  color: var(--v4-brand);
  min-height: 64rpx;
  display: flex;
  align-items: center;
}

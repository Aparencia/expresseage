<view class="page-body">
  <switch-bar />

  <view class="card">
    <view class="section-title">常见问题</view>
    <view wx:for="{{faqs}}" wx:key="q" class="faq-item">
      <view class="row between faq-question" data-index="{{index}}" bindtap="onFaqTap">
        <view class="flex-1 strong">{{item.q}}</view>
        <view class="small">{{expanded === index ? '收起' : '展开'}}</view>
      </view>
      <view class="muted faq-answer" wx:if="{{expanded === index}}">{{item.a}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">口径说明</view>
    <view class="muted statement">{{statements.zeroMoney}}</view>
    <view class="muted statement">{{statements.audit}}</view>
    <view class="muted statement">{{statements.ai}}</view>
    <view class="muted statement">{{statements.avatar}}</view>
  </view>

  <view class="card">
    <view class="tabs row">
      <view
        wx:for="{{docTabs}}"
        wx:key="key"
        class="tab-item flex-1 center {{doc === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onDocTap"
      >{{item.label}}</view>
    </view>
    <block wx:if="{{doc === 'privacy'}}">
      <view wx:for="{{sections}}" wx:key="title" class="doc-section">
        <view class="doc-section-title">{{item.title}}</view>
        <view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="muted paragraph">{{paragraph}}</view>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{paragraphs}}" wx:key="*this" class="muted paragraph">{{item}}</view>
    </block>
  </view>

  <view class="card version-card">
    <view class="muted">版本 {{version}} · 隐私政策版本 {{privacyVersion}} · 客服：请联系你的兼职</view>
  </view>
</view>

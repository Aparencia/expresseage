/* pkg-customer/pages/help/index.wxss */
.faq-item {
  border-bottom: 1rpx solid var(--v4-line);
  padding: 16rpx 0;
}

.faq-question {
  min-height: 64rpx;
}

.faq-answer {
  margin-top: 12rpx;
  line-height: 1.6;
}

.statement {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.tabs {
  margin-bottom: 20rpx;
  background: var(--v4-bg);
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab-item {
  min-height: 64rpx;
  font-size: 26rpx;
  color: var(--v4-text-2);
  border-radius: 8rpx;
}

.tab-active {
  background: #FFFFFF;
  color: var(--v4-brand);
  font-weight: 600;
}

.doc-section {
  margin-bottom: 24rpx;
}

.doc-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--v4-text);
  margin: 8rpx 0 12rpx;
}

.paragraph {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.version-card {
  text-align: center;
}

/* 分享提示（朋友圈入口只能走右上角菜单，平台限制见 D36） */
.share-line {
  margin-top: 12rpx;
  line-height: 1.6;
}

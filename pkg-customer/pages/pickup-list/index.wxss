.pickup-group {
  padding-bottom: 8rpx;
}

.group-head {
  padding-bottom: 8rpx;
}

.group-check {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.summary-row {
  margin-top: 12rpx;
  justify-content: space-between;
}

.pickup-row {
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.pickup-row:last-child {
  border-bottom: none;
}

.check-row {
  flex: 1;
  align-items: center;
}

.pickup-meta {
  margin-left: 16rpx;
}

.pickup-station {
  font-size: 28rpx;
}

.pickup-code {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--v4-brand);
}

.pickup-actions {
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.pickup-actions .link-text {
  min-height: 48rpx;
}

.btn-small {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

/* ── D57 我的取件码（本机）──────────────────────────────────────────── */
.local-card {
  padding-bottom: 16rpx;
}

.local-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8A8F99;
}

.local-actions {
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.local-actions .btn {
  margin: 0;
}

.local-clear {
  margin-left: auto;
  color: #E5484D;
}

.local-progress {
  margin-top: 12rpx;
}

.local-input {
  margin-top: 16rpx;
}

.local-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 40rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.local-input-actions {
  align-items: center;
  margin-top: 12rpx;
}

.local-input-actions .btn {
  margin: 0;
}

.local-summary {
  margin-top: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.local-row {
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.local-row:last-child {
  border-bottom: none;
}

.local-meta {
  margin-left: 16rpx;
}

.local-code {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--v4-brand);
}

.local-row-actions {
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.local-row-actions .link-text {
  min-height: 48rpx;
}

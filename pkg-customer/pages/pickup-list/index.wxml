<view class="page-body">
  <switch-bar />

  <!-- D57 我的取件码（本机）：只存这台手机、零上传；READONLY 会话不渲染交互区 -->
  <view class="card local-card" wx:if="{{!readonly}}">
    <view class="row between">
      <view class="section-title">我的取件码（本机）</view>
      <view class="small muted">{{localSummary.total}}/{{localMax}} 条</view>
    </view>
    <view class="local-tip">{{localTip}}</view>
    <view class="row local-actions">
      <button class="btn btn-small" bindtap="onRecognizeLocal" disabled="{{localBusy}}">识别截图</button>
      <button class="btn btn-ghost btn-small" bindtap="onToggleLocalInput" disabled="{{localBusy}}">{{localInputOpen ? '收起手动输入' : '手动粘贴'}}</button>
      <view class="small link-text local-clear" wx:if="{{localSummary.total}}" bindtap="onClearLocal">清空</view>
    </view>
    <view class="local-progress small muted" wx:if="{{localBusy}}">{{localProgress}}</view>
    <view class="local-input" wx:if="{{localInputOpen}}">
      <textarea class="local-textarea" value="{{localInput}}" placeholder="粘贴取件码，一行一个；站点认不出也能只存码" maxlength="2000" bindinput="onLocalInput" auto-height />
      <view class="row between local-input-actions">
        <view class="small muted">只存本机，不上传</view>
        <button class="btn btn-small" bindtap="onSubmitLocalInput">存到本机</button>
      </view>
    </view>
    <view class="row between local-summary" wx:if="{{localSummary.total}}">
      <view class="small muted">共 {{localSummary.total}} 条 · 已取到 {{localSummary.checked}} 条</view>
      <view class="small muted" wx:if="{{localSummary.pending}}">未取到 {{localSummary.pending}} 条</view>
    </view>
    <view class="empty-text" wx:if="{{!localSummary.total && !localBusy}}">{{localEmptyText}}</view>
    <view class="row between local-row" wx:for="{{localRows}}" wx:key="code">
      <view class="row check-row" data-code="{{item.code}}" bindtap="onToggleLocalCheck">
        <view class="check-box {{item.checked ? 'checked' : ''}}"></view>
        <view class="col local-meta">
          <view class="strong local-code">{{item.code}}</view>
          <view class="small muted">{{item.stationText}} · {{item.checkedText}}{{item.timeText ? ' · ' + item.timeText : ''}}</view>
        </view>
      </view>
      <view class="row local-row-actions">
        <view class="small link-text" data-code="{{item.code}}" bindtap="onCopyLocalCode">复制</view>
        <view class="small link-text" data-code="{{item.code}}" bindtap="onDeleteLocalCode">删除</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{readonly}}">
    <view class="section-title">我的取件码（本机）</view>
    <view class="muted small">{{localReadonlyHint}}</view>
  </view>

  <view class="card">
    <view class="row between">
      <view class="section-title">取件清单</view>
      <view class="small link-text" bindtap="onCopyAll">复制全部</view>
    </view>
    <view class="muted small">只显示本人进行中订单的站点与取件码。勾选「我已取到」只记在这台手机上，不改订单状态。</view>
    <view class="row between summary-row" wx:if="{{summary.total}}">
      <view class="small muted">共 {{summary.total}} 件</view>
      <view class="small muted">已取到 {{summary.checked}} 件</view>
      <view class="small muted" wx:if="{{summary.needCode}}">需查明 {{summary.needCode}} 件</view>
    </view>
  </view>

  <view class="card" wx:if="{{loading && !groups.length}}">
    <view class="empty-text">正在加载取件清单…</view>
  </view>

  <view class="card" wx:if="{{error && !groups.length}}">
    <view class="muted">{{error}}</view>
    <button class="btn btn-ghost btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <view class="card" wx:if="{{!loading && !error && !groups.length}}">
    <view class="empty-text">现在没有进行中的取件。下单后，站点与取件码会出现在这里。</view>
  </view>

  <view class="card pickup-group" wx:for="{{groups}}" wx:key="orderNo" wx:if="{{!loading || groups.length}}">
    <view class="row between group-head">
      <view class="small link-text" data-order-no="{{item.orderNo}}" bindtap="onOrderTap">订单 {{item.orderNo}}</view>
      <view class="small muted">{{item.statusText || ''}}{{item.timeText ? ' · ' + item.timeText : ''}}</view>
    </view>
    <view class="row between group-check">
      <view class="small muted">{{item.rows.length}} 件 · 已取到 {{item.checkedCount}} 件</view>
      <view class="small link-text" data-order-no="{{item.orderNo}}" bindtap="onToggleGroup">{{item.allChecked ? '取消本单勾选' : '本单全部勾选'}}</view>
    </view>

    <view class="row between pickup-row" wx:for="{{item.rows}}" wx:for-item="row" wx:key="key">
      <view class="row check-row" data-key="{{row.key}}" bindtap="onToggleCheck">
        <view class="check-box {{row.checked ? 'checked' : ''}}"></view>
        <view class="col pickup-meta">
          <view class="strong pickup-station">第 {{row.no}} 件 · {{row.stationName}}</view>
          <view class="pickup-code {{row.needCode ? 'error-text' : ''}}">{{row.codeText}}</view>
        </view>
      </view>
      <view class="row pickup-actions">
        <view class="small link-text" wx:if="{{row.hasCode}}" data-key="{{row.key}}" bindtap="onCopyCode">复制码</view>
        <view class="small link-text" data-key="{{row.key}}" bindtap="onCopyLine">复制行</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{readonly}}">
    <view class="muted small">开发者只读视角：勾选只影响本机显示。</view>
  </view>
</view>

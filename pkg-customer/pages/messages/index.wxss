/* pkg-customer/pages/messages/index.wxss */
.head-row {
  margin-bottom: 24rpx;
}

.mark-read-disabled {
  color: #999999;
}

.announcement {
  padding: 20rpx 24rpx;
}

.announcement-title {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  flex: 1;
}

.announcement-text {
  margin-top: 8rpx;
}

.message-card {
  padding: 20rpx 24rpx;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--v4-danger);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.message-text {
  margin-top: 8rpx;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

.load-more {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #1F7A5C;
}

.read-error {
  padding: 8rpx 0 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

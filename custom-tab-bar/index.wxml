<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab-item"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="tab-icon-wrap">
      <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
      <text wx:if="{{item.badgeKey && badges[item.badgeKey]}}" class="tab-badge">{{badges[item.badgeKey]}}</text>
    </view>
    <text class="tab-text {{selected === index ? 'tab-text-active' : ''}}">{{item.text}}</text>
  </view>
</view>

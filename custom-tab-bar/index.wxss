.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -20rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #E54D42;
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 2rpx;
}

.tab-text-active {
  color: #1F7A5C;
  font-weight: 600;
}

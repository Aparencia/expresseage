/* pages/customer/home/index.wxss */
.announcement {
  padding: 20rpx 24rpx;
}

.tip-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.partner-meta {
  margin-left: 20rpx;
  min-width: 0;
}

.order-card {
  padding-bottom: 12rpx;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.tag-disabled {
  background: #F0F2F5;
  color: var(--v4-text-3);
}

.home-links {
  margin-top: 24rpx;
}

.link-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  color: var(--v4-text-2);
  font-size: 28rpx;
}

.red-dot {
  width: 16rpx;
  height: 16rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--v4-danger);
}

/* D26：取件清单入口卡片 */
.pickup-entry {
  margin-top: 8rpx;
}

.link-text {
  color: var(--v4-brand);
  min-height: 64rpx;
  display: flex;
  align-items: center;
}

/* P1-7：顾客首用三步引导（遮罩可跳过；不承载业务操作） */
.guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  z-index: 20;
}

.guide-box {
  width: 600rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.guide-title {
  margin: 12rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.guide-actions {
  margin-top: 24rpx;
  align-items: center;
}

.guide-skip {
  padding: 16rpx 24rpx;
  color: var(--v4-text-2);
}

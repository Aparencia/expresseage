<view class="page-body">
  <switch-bar />

  <view class="card" wx:if="{{singlePage}}">
    <view class="section-title">朋友圈预览</view>
    <view class="muted">{{singlePageHint}}</view>
  </view>

  <view class="card announcement" wx:if="{{announcement && !announcementClosed}}">
    <view class="row between">
      <view class="muted flex-1 ellipsis">公告：{{announcement}}</view>
      <view class="small" bindtap="onCloseAnnouncement">知道了</view>
    </view>
  </view>

  <view class="card tip-card" wx:if="{{!vm.customer.profileComplete}}">
    <view class="muted flex-1">还差苑/楼栋/宿舍号 —— 完善后才能下单。</view>
    <button class="btn btn-ghost btn-small" bindtap="onProfileTap">去完善</button>
  </view>

  <!-- 我的兼职卡（压缩高度）：头像 + 昵称（接单状态标在昵称旁）+ 编号 + 服务类型/范围两行；
       不展示兼职端宿舍楼栋，避免被误读成「兼职人员的楼栋」 -->
  <view class="card partner-card" wx:if="{{vm.binding}}">
    <view class="row between partner-head">
      <view class="row flex-1 partner-id">
        <avatar-view file-id="{{partnerCard.avatarFileId}}" name="{{partnerCard.name}}" size="88" />
        <view class="col partner-meta flex-1">
          <view class="row partner-name-row">
            <text class="section-title ellipsis partner-name">我的兼职 · {{partnerCard.name || '资料加载中'}}</text>
            <view class="tag partner-status {{partnerCard.accepting ? '' : 'tag-disabled'}}">{{partnerCard.acceptingText}}</view>
          </view>
          <id-text kind="PARTNER" no="{{partnerCard.partnerNo}}" />
        </view>
      </view>
      <button class="btn btn-ghost btn-small" bindtap="onRebindTap">换绑</button>
    </view>
    <view class="col partner-lines" wx:if="{{partnerCard.loaded}}">
      <view class="muted partner-line">服务类型：{{servicesText || '暂未设置'}}</view>
      <view class="muted partner-line">服务范围：{{scopeText}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{!vm.binding}}">
    <view class="section-title">还没有绑定兼职</view>
    <view class="muted">向兼职要完整兼职编号（P-XXX-XXX，如 P-7K2-M9X），输入后即可下单。</view>
    <view class="form-row">
      <input class="form-input" placeholder="完整兼职编号，如 P-7K2-M9X" value="{{bindInput}}" bindinput="onBindInput" />
    </view>
    <button class="btn btn-primary btn-block" bindtap="onBindTap">去绑定</button>
  </view>

  <view class="card order-card" wx:if="{{order}}">
    <view class="row between">
      <view class="section-title">进行中的订单</view>
      <view class="small">{{waitedText}}</view>
    </view>
    <order-row order="{{orderRow}}" data-order-no="{{order.orderNo}}" bind:tap="onOrderTap" />
  </view>

  <!-- D26：取件清单独立入口（本人进行中订单的站点+取件码，仅本机勾选） -->
  <view class="card pickup-entry" bindtap="onPickupListTap">
    <view class="row between">
      <view class="col">
        <view class="section-title">取件清单</view>
        <view class="muted small">看站点和取件码，可复制；勾选只记在这台手机</view>
      </view>
      <view class="small link-text">查看</view>
    </view>
  </view>

  <view class="card order-empty-card" wx:if="{{!loading && !order && vm.binding}}">
    <view class="muted order-empty-text">还没有进行中的订单，上传取件码截图就能下单。</view>
  </view>

  <view class="card" wx:if="{{error}}">
    <view class="muted">{{error}}</view>
    <button class="btn btn-ghost btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <button class="btn btn-primary btn-block {{canOrder ? '' : 'btn-disabled'}}" bindtap="onOrderCreateTap">
    {{canOrder ? '上传取件码截图下单' : orderDisabledReason}}
  </button>

  <view class="row home-links">
    <view class="flex-1 center link-item" bindtap="onMessagesTap">
      <text>消息中心</text>
      <view class="red-dot" wx:if="{{vm.badges.messages > 0}}"></view>
    </view>
    <view class="flex-1 center link-item" bindtap="onProfileTap">我的</view>
  </view>

  <!-- 分享入口：好友转发用按钮触发；朋友圈只能走右上角菜单（平台限制，见 D36）；切换会话不提供 -->
  <view class="card" wx:if="{{!singlePage && !vm.viewContext}}">
    <view class="row between">
      <view class="muted flex-1">把小程序分享给同学</view>
      <button class="btn btn-ghost btn-small" open-type="share">分享</button>
    </view>
    <view class="muted share-tip">{{shareTip}}</view>
  </view>

  <!-- P1-7：顾客首用三步引导（可跳过；完成/跳过只写本机引导标记） -->
  <view class="guide-mask" wx:if="{{guide.visible}}">
    <view class="guide-box">
      <view class="small muted">{{guide.stepText}}</view>
      <view class="guide-title">{{guide.title}}</view>
      <view class="muted">{{guide.text}}</view>
      <view class="row between guide-actions">
        <view class="small guide-skip" bindtap="onGuideSkip">{{guide.skipText}}</view>
        <button class="btn btn-primary btn-small" bindtap="onGuideNext">{{guide.primaryText}}</button>
      </view>
    </view>
  </view>

  <!-- 维护模式全屏公告（页面级注册；enabled 由 utils/maintenance 纯件计算） -->
  <maintenance-mask
    enabled="{{maintenance.visible}}"
    title="{{maintenance.title}}"
    text="{{maintenance.text}}"
    bind:ack="onMaintenanceAck"
  />
</view>

/* pages/customer/orders/index.wxss */
.tabs {
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
}

/* 分组 tab：子项在 .tabs.row 里必须自成 flex 容器，center 类（justify/align）才生效，文案才算居中 */
.tab-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  font-size: 28rpx;
  color: var(--v4-text-2);
  border-radius: 12rpx;
}

.tab-active {
  color: var(--v4-brand);
  font-weight: 600;
  background: #EAF4EF;
}

.tab-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--v4-brand);
}

.list-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 24rpx;
}

.reorder-btn {
  margin: 0 0 12rpx auto;
  display: flex;
}

/* D61 部分取件：行内「已取 n/m 件」小标签（只读展示，不参与点击热区以外的判据） */
.pickup-tag {
  display: inline-block;
  margin: 0 0 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF4EF;
  color: var(--v4-brand);
  font-size: 22rpx;
  line-height: 1.6;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

/* 批20-C：首屏灰色骨架占位（与订单行同构：头像圆 + 两行灰条），替掉文字「加载中…」 */
.skeleton-item {
  padding: 24rpx;
}

.skeleton-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EEF0F3;
}

.skeleton-main {
  margin-left: 20rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #EEF0F3;
  margin-bottom: 12rpx;
}

.skeleton-line.short {
  width: 40%;
}

/* pages/customer/orders/index.wxss */
.tabs {
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
}

.tab-item {
  min-height: 72rpx;
  font-size: 28rpx;
  color: var(--v4-text-2);
  border-radius: 12rpx;
}

.tab-active {
  color: var(--v4-brand);
  font-weight: 600;
  background: #EAF4EF;
}

.list-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 24rpx;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

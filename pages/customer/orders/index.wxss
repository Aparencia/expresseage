/* pages/customer/orders/index.wxss */
.tabs {
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
}

/* 分组 tab：子项在 .tabs.row 里必须自成 flex 容器，center 类（justify/align）才生效，文案才算居中 */
.tab-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  font-size: 28rpx;
  color: var(--v4-text-2);
  border-radius: 12rpx;
}

.tab-active {
  color: var(--v4-brand);
  font-weight: 600;
  background: #EAF4EF;
}

.tab-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--v4-brand);
}

.list-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 24rpx;
}

.reorder-btn {
  margin: 0 0 12rpx auto;
  display: flex;
}

.btn-small {
  min-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
}

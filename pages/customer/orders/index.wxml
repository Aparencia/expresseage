<view class="page-body page-body--tab">
  <switch-bar />

  <view class="tabs row">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item flex-1 center {{activeKey === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      <text>{{item.label}}</text>
      <text class="tab-count" wx:if="{{item.count > 0}}">{{item.count > 99 ? '99+' : item.count}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{error}}">
    <view class="muted">{{error}}</view>
    <button class="btn btn-ghost btn-small" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 批20-C：首屏（慢网 >300ms）灰色骨架占位（替掉文字加载态）；
       只在 list 为空时出现——onShow 刷新保留旧列表，不闪骨架、不跳顶部 -->
  <block wx:if="{{loadingVisible && list.length === 0}}">
    <view wx:for="{{skeletonRows}}" wx:key="*this" class="card skeleton-item">
      <view class="row">
        <view class="skeleton-avatar"></view>
        <view class="flex-1 skeleton-main">
          <view class="skeleton-line"></view>
          <view class="skeleton-line short"></view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="orderNo" class="list-item">
      <view data-order-no="{{item.orderNo}}" bindtap="onOrderTap">
        <order-row order="{{item}}" />
      </view>
      <button
        class="btn btn-ghost btn-small reorder-btn"
        wx:if="{{item.reorderable}}"
        data-order-no="{{item.orderNo}}"
        catchtap="onReorderTap"
      >再次下单</button>
    </view>
  </view>

  <empty-state
    wx:if="{{!loading && list.length === 0 && !error}}"
    text="{{emptyText}}"
    action-text="{{emptyActionText}}"
    bind:action="onEmptyAction"
  />

  <view class="empty-text" wx:if="{{!loading && list.length > 0 && !hasMore}}">没有更多了</view>
</view>

<!-- pages/partner/customers/index.wxml · 客户档案（只列已被顾客绑定的顾客） -->
<view class="page-body">
  <switch-bar />
  <view class="row between head">
    <view class="title">客户</view>
    <view class="row">
      <view class="btn btn-ghost head-btn" bindtap="onCopyPartnerNo">复制编号</view>
      <view class="btn btn-primary head-btn" bindtap="goCreateOnBehalf">代客下单</view>
    </view>
  </view>

  <view class="card search-card">
    <input
      class="form-input"
      placeholder="搜索：楼栋 / 宿舍 / 称呼 / 尾号"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
    />
  </view>

  <view class="card guide-card">
    <view class="strong">绑定只能由顾客发起</view>
    <view class="small">把绑定卡片或兼职编号发给顾客，顾客在自己手机上确认后才会建立绑定；兼职端不提供添加、绑定、导入顾客的入口。</view>
  </view>

  <view wx:if="{{loading}}" class="empty-text">加载中…</view>
  <view wx:elif="{{error}}" class="card">
    <empty-state text="{{error}}" actionText="重试" bind:action="load" />
  </view>
  <view wx:elif="{{!list.length}}" class="card">
    <empty-state
      text="{{total ? '这个搜索下没有顾客' : '还没有绑定顾客。把绑定卡片发给顾客，让顾客自己绑定。'}}"
      actionText="{{total ? '' : '分享绑定卡片'}}"
      bind:action="onShareTap"
    />
  </view>

  <view wx:for="{{list}}" wx:key="bindingId" class="card customer-item" data-index="{{index}}" bindtap="onRowTap">
    <avatar-view fileId="{{item.avatarFileId}}" name="{{item.displayName}}" size="{{64}}" />
    <view class="flex-1 customer-main">
      <view class="row between">
        <view class="strong ellipsis">{{item.displayName || '未填称呼'}}</view>
        <view wx:if="{{item.activeOrderCount}}" class="tag">进行中 {{item.activeOrderCount}}</view>
      </view>
      <view class="muted ellipsis">{{item.anchorKeyText}}</view>
      <view class="small">顾客编号 {{item.customerNo}}<text wx:if="{{item.boundAtText}}"> · 绑定 {{item.boundAtText}}</text></view>
    </view>
  </view>

  <view class="row bottom-actions">
    <button wx:if="{{!session}}" class="btn btn-ghost btn-block share-btn" open-type="share">
      分享绑定卡片（顾客自己绑定）
    </button>
  </view>
</view>

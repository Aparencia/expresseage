/* pages/partner/customers/index.wxss · 客户列表局部样式 */
.head {
  padding: 8rpx 0 24rpx;
}

.head-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
}

.banner-card {
  background: #E8F0FF;
}

.banner-text {
  font-size: 26rpx;
  color: #2B6DE5;
}

.search-card {
  padding: 8rpx 24rpx;
}

/* D67 筛选器：横滚 chips（全部/资料未完善/按苑/按楼栋/有备注）+ 苑/楼栋二级选择 */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.filter-row {
  display: inline-flex;
}

.chip {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  margin: 0 16rpx 8rpx 0;
}

.chip-active {
  background: var(--v4-partner);
  color: #FFFFFF;
}

.filter-desc {
  padding: 0 8rpx 16rpx;
  align-items: center;
}

.filter-desc .small {
  color: #8A6D00;
}

.filter-clear {
  font-size: 24rpx;
  color: var(--v4-partner);
  padding: 8rpx 0 8rpx 24rpx;
}

.stale-card {
  background: #FFF4CE;
}

.skeleton-card {
  align-items: center;
  /* 与真实行同高（头像 64 + 三行文字 + 卡片上下 padding 48），数据到达不跳版 */
  min-height: 176rpx;
}

.skeleton-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EEF0F3;
}

.skeleton-main {
  margin-left: 20rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: #EEF0F3;
  margin-bottom: 12rpx;
}

.skeleton-line.short {
  width: 40%;
}

.customer-item {
  align-items: center;
}

.customer-main {
  margin-left: 20rpx;
  min-width: 0;
}

.customer-main .muted {
  margin-top: 4rpx;
}

.anchor-row {
  margin-top: 4rpx;
  align-items: center;
}

/* 资料未完善（dormKey 为空，服务端已置底）：行上明示，不显示假宿舍锚 */
.incomplete-text {
  margin-left: 12rpx;
  flex-shrink: 0;
  background: #FFF4CE;
  color: #8A6D00;
}

.meta-row {
  margin-top: 8rpx;
}

.row-btn {
  min-height: 56rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.footer-text {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 16rpx 0;
}

.bottom-actions {
  /* 批20-C 底部安全区：tabBar 100rpx + 120rpx 底垫（含 iPhone 底部安全区），
     15 名顾客滚到底时「分享绑定卡片」完整可见、不被 tabBar 遮住 */
  padding: 8rpx 0 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.share-btn {
  background: #FFFFFF;
}

/* pages/partner/workbench/parts/transfer.wxss · D58 待接收转派区块（顶部入口；样式与行卡同一套视觉） */

.transfer-card {
  padding: 20rpx 24rpx 8rpx;
  border: 1rpx solid #D8E3FA;
}

.transfer-head {
  padding-bottom: 12rpx;
}

.transfer-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--v4-line);
}

.transfer-line:last-child {
  border-bottom: none;
}

.transfer-line-top,
.transfer-line-foot {
  align-items: center;
}

.transfer-from {
  color: var(--v4-partner);
  font-weight: 600;
}

.transfer-remain {
  background: #FFF3E6;
  color: var(--v4-warning-text);
}

.transfer-line-foot {
  margin-top: 6rpx;
}

.transfer-meta {
  color: #6B7280;
}

.transfer-hint {
  padding: 8rpx 0 16rpx;
  color: var(--v4-text-4);
}

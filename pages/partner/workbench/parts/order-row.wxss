.station-card {
  padding: 0 24rpx 8rpx;
}

.station-head {
  padding: 24rpx 0 12rpx;
}

.order-line {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0 20rpx 16rpx;
  border-bottom: 1rpx solid var(--v4-line);
  /* 2026-11-08 行改版：左侧状态色条提高相邻订单区分度（忙碌时不易看差） */
  border-left: 6rpx solid transparent;
}

.order-line--submitted { border-left-color: var(--v4-partner); }
.order-line--accepted { border-left-color: var(--v4-brand); }
.order-line--picked { border-left-color: var(--v4-warning-text); }
.order-line--delivered { border-left-color: #7A5AF8; }
.order-line--exception { border-left-color: var(--v4-danger); }
.order-line--history { border-left-color: #C9CED6; }

.order-line-active {
  background: var(--v4-info-weak);
}

.check-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--v4-line-strong);
  margin: 6rpx 16rpx 0 0;
  flex-shrink: 0;
}

.check-dot-on {
  background: var(--v4-partner);
  border-color: var(--v4-partner);
}

.check-dot-disabled {
  background: var(--v4-fill);
  border-color: #E5E8EC;
}

.line-main {
  min-width: 0;
}

/* 两行结构：第一行 状态+单号+时间；第二行 宿舍锚+档位（2026-11-08 行改版） */
.line-title {
  align-items: center;
  flex-wrap: wrap;
}

.line-time {
  margin-left: auto;
  color: var(--v4-text-4);
}

.line-sub {
  margin-top: 4rpx;
  align-items: baseline;
}

.line-tier {
  margin-left: 12rpx;
  color: var(--v4-text-4);
}

.code-text {
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 12rpx;
}

.code-locker {
  margin-right: 12rpx;
}

.guest-tag {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

/* v1.0 多包裹行聚合（D23/D24）：件数/站点聚合/无截图·手填 */
.parcel-tag {
  background: #EAF4F0;
  color: var(--v4-brand);
}

.manual-tag {
  background: var(--v4-fill);
  color: #4A4A4A;
}

/* D45/M1：未送达跨日行「顺延 N 天」标签（与取件码同行，不挤掉柜号/档位） */
.delay-tag {
  background: var(--v4-readonly-bg);
  color: var(--v4-readonly-text);
}

.station-summary {
  margin: 0 12rpx;
  color: var(--v4-text-2);
}

.parcel-need-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--v4-readonly-bg);
  color: var(--v4-readonly-text);
  font-size: 22rpx;
  margin: 8rpx 12rpx 0 0;
}

/* 补码面板逐件切换器（v1.0）：件状态 chip 横排 */
.panel-pieces {
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.panel-piece-hint {
  margin-bottom: 12rpx;
  color: var(--v4-text-2);
}

.line-tags {
  flex-wrap: wrap;
}

.review-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--v4-fill);
  color: var(--v4-text-2);
  font-size: 22rpx;
  margin: 8rpx 12rpx 0 0;
}

/* 送别人：行锚是下单人宿舍，目的地址必须单独标出来（2026-11-08 用户真机反馈） */
.delivery-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--v4-test-bg);
  color: var(--v4-partner);
  font-size: 22rpx;
  margin: 8rpx 12rpx 0 0;
}

.exception-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--v4-danger);
}

/* 行工具条：动作键全部来自服务端 actions[] */
.row-tools {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.tool-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  margin: 8rpx 16rpx 0 0;
  border-radius: 10rpx;
  border: 2rpx solid var(--v4-line-strong);
  font-size: 24rpx;
  color: var(--v4-text);
}

.tool-primary {
  border-color: var(--v4-partner);
  color: var(--v4-partner);
  font-weight: 600;
}

.tool-danger {
  border-color: var(--v4-danger);
  color: var(--v4-danger);
}

.tool-detail {
  border-color: transparent;
  color: var(--v4-text-3, var(--v4-text-3));
}

/* 2026-11-08 按钮方案 B：低频动作收进「更多」（异常/留言/取消/拒单），行内只留主操作+改取件码+详情 */
.tool-more {
  border-color: var(--v4-line-strong);
  color: var(--v4-text-2);
}

.line-readonly {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--v4-text-3, var(--v4-text-3));
}

/* D61/D62：件级取件行（缩进 32rpx + 左侧竖线；单件单不缩进、不显示「第 n 件」） */
.order-no-text {
  margin: 0 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--v4-text);
}

.picked-summary-tag {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.piece-list {
  margin-top: 8rpx;
}

.piece-list--indent {
  padding-left: 32rpx;
  border-left: 4rpx solid #E5E8EC;
  margin-left: 8rpx;
}

.piece-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  min-height: 72rpx;
}

.piece-row--picked .piece-code {
  color: var(--v4-text-4);
  text-decoration: line-through;
}

.piece-main {
  min-width: 0;
}

.piece-top {
  align-items: center;
  flex-wrap: wrap;
}

.piece-index {
  font-size: 22rpx;
  color: var(--v4-text-3, var(--v4-text-3));
  margin-right: 12rpx;
}

/* 取件码：大字等宽，可点复制 */
.piece-code {
  font-family: Menlo, Consolas, monospace;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--v4-text);
  margin-right: 12rpx;
}

.piece-code--need {
  color: var(--v4-readonly-text);
}

.piece-station {
  color: var(--v4-text-2);
  margin-right: 12rpx;
}

.piece-locker {
  color: var(--v4-text-2);
  margin-right: 12rpx;
}

.piece-need {
  background: var(--v4-readonly-bg);
  color: var(--v4-readonly-text);
}

.piece-picked {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
}

.piece-btn {
  min-height: 60rpx;
  line-height: 60rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.piece-other {
  padding: 4rpx 0 8rpx;
  color: var(--v4-readonly-text);
}

/* 批 37：动作面板统一为页面级模态浮层（遮罩 + 底部面板）。
   z-index 必须高于底部操作条（600），否则面板被压住；bottom:0 + env(safe-area) 由门禁 #38 核对。 */
.panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 700;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
}

/* 顶部小横条：一眼看出这是可下拉关闭的底部浮层 */
.panel-grip {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 8rpx;
  background: #D8DEE9;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.panel-options {
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}

.panel-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #E54D42;
}

.panel-actions {
  margin-top: 16rpx;
  justify-content: flex-end;
}

/* 已完结自然日分区 */
.completed-fold {
  padding: 24rpx;
  color: #2B6DE5;
  font-size: 28rpx;
}

/* D81 已转出：折叠入口 + 行（只读，无操作）；与已完结分区同卡风格 */
.handover-fold {
  padding: 24rpx;
  color: #2B6DE5;
  font-size: 28rpx;
}

.handover-card {
  padding: 8rpx 24rpx 16rpx;
}

.handover-line {
  padding: 16rpx 0;
  border-top: 1rpx solid #EEF1F6;
}

.handover-line:first-child {
  border-top: 0;
}

/* 只读进度浮层（D81）：键值两列，右侧值自动换行 */
.tracking-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F3F8;
  font-size: 28rpx;
}

.tracking-row:last-of-type {
  border-bottom: 0;
}

.tracking-hint {
  margin-top: 16rpx;
  line-height: 1.5;
}

.completed-card {
  padding: 20rpx 24rpx 24rpx;
}

.completed-head {
  padding-bottom: 12rpx;
}

.section-label {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.history-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.history-muted {
  opacity: 0.72;
}

.cancel-text {
  margin-top: 6rpx;
  color: #E54D42;
}

.more-btn {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2B6DE5;
}

/* D65：批量操作条的固定底盘与 safe-area 底垫由 components/bottom-bar 提供，
   本文件只保留条内内容布局类（不再自造 static 垫高） */
.batch-head {
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.batch-actions {
  flex-wrap: wrap;
}

.batch-btn {
  flex: 1;
  min-width: 140rpx;
  margin: 0 8rpx 8rpx 0;
}

/* 撤销条：浮在 tabBar 上方（token 组合，不写死 160rpx）；批量条同时出现时再上抬一档 */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(var(--v4-inset-tab) + 16rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
}

.undo-bar-above-batch {
  bottom: calc(var(--v4-inset-bar) + 32rpx);
}

.undo-btn {
  background: #FFFFFF;
  color: #1A1A1A;
  border-color: #FFFFFF;
}

/* 首用引导 */
.guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}

.guide-box {
  width: 600rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.guide-text {
  margin: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: #666666;
}

.guide-partner {
  margin-bottom: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #F3F7FF;
  font-size: 24rpx;
  color: #2B6DE5;
}

.guide-actions {
  justify-content: flex-end;
}

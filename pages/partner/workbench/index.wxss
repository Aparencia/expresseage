/* pages/partner/workbench/index.wxss · 工作台局部样式（骨架屏/筛选/行/浮层/批量条/撤销条/引导/已完结分区） */
.workbench-body {
  padding-bottom: 220rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.mini-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
}

/* 页内新订单横幅：只提示不抢操作 */
.new-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #E8F0FF;
  color: #2B6DE5;
  font-size: 26rpx;
}

.new-banner-action {
  font-weight: 600;
  margin-left: 16rpx;
}

.counts-card {
  padding: 20rpx 16rpx 12rpx;
}

.counts-grid {
  display: flex;
  flex-wrap: wrap;
}

.count-cell {
  width: 33.33%;
  padding: 8rpx 0;
  text-align: center;
  box-sizing: border-box;
}

.count-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #2B6DE5;
}

.updated-row {
  margin-top: 8rpx;
}

.warn-card {
  background: #FFF4CE;
}

.warn-text {
  color: #8A6D00;
  font-size: 24rpx;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.filter-row {
  display: inline-flex;
}

.chip {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
  margin: 0 16rpx 8rpx 0;
}

.chip-active {
  background: #2B6DE5;
  color: #FFFFFF;
}

.filter-desc {
  padding: 0 8rpx 12rpx;
  font-size: 24rpx;
  color: #8A6D00;
}

.search-card {
  padding: 8rpx 24rpx;
}

/* 骨架屏：3 张站点卡占位，不转圈 */
.skeleton-card {
  padding: 28rpx 24rpx;
}

.skeleton-line {
  height: 24rpx;
  margin: 12rpx 0;
  border-radius: 12rpx;
  background: #EEF1F5;
}

.skeleton-title {
  width: 40%;
  height: 32rpx;
}

.skeleton-short {
  width: 60%;
}

.empty-card {
  padding: 36rpx 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.partner-line {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F3F7FF;
  font-size: 24rpx;
  color: #2B6DE5;
}

.empty-actions {
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.share-hint {
  margin-top: 12rpx;
}

.station-card {
  padding: 0 24rpx 8rpx;
}

.station-head {
  padding: 24rpx 0 12rpx;
}

.order-line {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.order-line-active {
  background: #F3F7FF;
}

.check-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid #D9DEE5;
  margin: 6rpx 16rpx 0 0;
  flex-shrink: 0;
}

.check-dot-on {
  background: #2B6DE5;
  border-color: #2B6DE5;
}

.check-dot-disabled {
  background: #F0F2F5;
  border-color: #E5E8EC;
}

.line-main {
  min-width: 0;
}

.line-title {
  align-items: center;
  flex-wrap: wrap;
}

.code-text {
  font-size: 32rpx;
  font-weight: 600;
  margin: 0 12rpx;
}

.code-locker {
  margin-right: 12rpx;
}

.guest-tag {
  background: #E8F0FF;
  color: #2B6DE5;
}

.line-foot {
  margin-top: 6rpx;
}

.line-tags {
  flex-wrap: wrap;
}

.need-code-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF4CE;
  color: #8A6D00;
  font-size: 22rpx;
  margin: 8rpx 12rpx 0 0;
}

.review-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #F0F2F5;
  color: #666666;
  font-size: 22rpx;
  margin: 8rpx 12rpx 0 0;
}

.exception-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #E54D42;
}

/* 行工具条：动作键全部来自服务端 actions[] */
.row-tools {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.tool-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  margin: 8rpx 16rpx 0 0;
  border-radius: 10rpx;
  border: 2rpx solid #D9DEE5;
  font-size: 24rpx;
  color: #333333;
}

.tool-primary {
  border-color: #2B6DE5;
  color: #2B6DE5;
  font-weight: 600;
}

.tool-danger {
  border-color: #E54D42;
  color: #E54D42;
}

.tool-detail {
  border-color: transparent;
  color: #999999;
}

.line-readonly {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 行内浮层（补码/原因/异常/送达备注/批量改站点） */
.panel-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #F8FAFD;
  border: 1rpx solid #E1E7F0;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.panel-options {
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #FFFFFF;
  font-size: 26rpx;
}

.panel-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #E54D42;
}

.panel-actions {
  margin-top: 16rpx;
  justify-content: flex-end;
}

/* 批量改站点浮层挂在页级（不属于某一行） */
.panel-page-card {
  padding: 20rpx 24rpx;
  border: 1rpx solid #E1E7F0;
  background: #F8FAFD;
}

/* 已完结自然日分区 */
.completed-fold {
  padding: 24rpx;
  color: #2B6DE5;
  font-size: 28rpx;
}

.completed-card {
  padding: 20rpx 24rpx 24rpx;
}

.completed-head {
  padding-bottom: 12rpx;
}

.section-label {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.history-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
}

.history-muted {
  opacity: 0.72;
}

.cancel-text {
  margin-top: 6rpx;
  color: #E54D42;
}

.more-btn {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2B6DE5;
}

.bottom-safe {
  height: 120rpx;
}

/* 批量操作条 */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.batch-head {
  flex-wrap: wrap;
  padding-bottom: 8rpx;
}

.batch-actions {
  flex-wrap: wrap;
}

.batch-btn {
  flex: 1;
  min-width: 140rpx;
  margin: 0 8rpx 8rpx 0;
}

/* 撤销条：浮在 tabBar 上方，不遮挡底部操作 */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 160rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
}

.undo-btn {
  background: #FFFFFF;
  color: #1A1A1A;
  border-color: #FFFFFF;
}

/* 首用引导 */
.guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 30;
}

.guide-box {
  width: 600rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.guide-text {
  margin: 16rpx 0 20rpx;
  font-size: 28rpx;
  color: #666666;
}

.guide-partner {
  margin-bottom: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #F3F7FF;
  font-size: 24rpx;
  color: #2B6DE5;
}

.guide-actions {
  justify-content: flex-end;
}

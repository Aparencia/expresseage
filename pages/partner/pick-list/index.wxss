/* pkg-partner/pages/pick-list/index.wxss · 取件清单局部样式（阶段 chip + 站点/楼层分组卡片 + 多选 + 底部批量条） */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.stage-chips {
  display: flex;
  padding: 0 0 16rpx;
}

/* D103：转出单入口 + 首屏说明收口（原多行 intro-card 压缩为汇总行） */
.handover-link {
  margin-right: 12rpx;
}

.pick-summary {
  padding: 0 8rpx 16rpx;
}

.pick-summary-text {
  color: var(--v4-brand);
}

.handover-hint {
  margin-top: 6rpx;
  color: var(--v4-warning-text);
}

.chip {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: var(--v4-card);
  color: var(--v4-text-2);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-active {
  background: var(--v4-partner);
  color: #FFFFFF;
}

.copy-group-btn,
.copy-row-btn {
  margin-left: 16rpx;
  flex: none;
}

.copy-btn {
  margin-left: 12rpx;
}

.intro-card {
  padding: 24rpx;
}

.intro-text {
  line-height: 1.6;
}

.intro-summary {
  color: var(--v4-brand);
  margin-top: 8rpx;
}

.intro-loaded {
  color: var(--v4-readonly-text);
  margin-top: 8rpx;
}

.readonly-tip {
  color: var(--v4-readonly-text);
  margin-top: 8rpx;
}

.test-tip {
  color: var(--v4-partner);
  margin-top: 8rpx;
}

.loading-text {
  padding: 48rpx 0;
  text-align: center;
}

.floor-card {
  padding: 0 24rpx 8rpx;
  margin-top: 24rpx;
}

.floor-head {
  padding: 24rpx 0 16rpx;
  border-bottom: 1rpx solid var(--v4-line);
}

.floor-title {
  font-size: 32rpx;
}

.order-line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.order-line:last-child {
  border-bottom: none;
}

.order-line-active {
  background: #F0F7F4;
}

.check-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C9D2DC;
  margin-right: 16rpx;
  flex: none;
}

.check-dot-on {
  background: var(--v4-brand);
  border-color: var(--v4-brand);
}

.line-main {
  min-width: 0;
}

.line-top {
  align-items: center;
}

/* D96（2026-11-19 用户指令）：取件码仍为最大字号，宿舍锚与码同域（锚做左侧标签、码在右侧），
   每单一个闭合容器；件行缩进 + 从属竖线，避免同站多单看串行 */
.pick-order {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E6EAEF;
  border-radius: 12rpx;
  background: #FBFCFD;
}

.pick-order:last-child {
  margin-bottom: 0;
}

.pick-head {
  align-items: center;
}

.pick-anchor {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #EEF3F8;
  color: #34495E;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pick-meta {
  margin-top: 8rpx;
  align-items: center;
  gap: 8rpx;
}

.pick-order .piece-line--pick {
  margin-left: 8rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #D8E1EA;
}

.pickup-code {
  flex-shrink: 0;
  max-width: 62%;
  text-align: right;
  font-family: Menlo, Consolas, monospace;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--v4-brand);
  letter-spacing: 1rpx;
  word-break: break-all;
}

.pickup-code--need {
  color: var(--v4-warning-text);
}

.line-sub {
  align-items: center;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.anchor-text {
  color: var(--v4-text-2);
}

.room-text {
  font-size: 34rpx;
  margin-right: 12rpx;
}

/* 2026-11-08：送别人时行内明示「送至」，否则锚和下单人宿舍无法区分 */
.send-to-label {
  color: var(--v4-partner);
  font-weight: 600;
  margin-right: 4rpx;
}

.room-tag {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
  margin-right: 12rpx;
}

.parcel-count {
  color: var(--v4-text-2);
}

.piece-line {
  margin-top: 4rpx;
  color: var(--v4-text);
}

.piece-station {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: #FFF4E5;
  color: var(--v4-warning-text);
  font-size: 22rpx;
}

.line-foot {
  margin-top: 8rpx;
}

.deliver-btn {
  margin-left: 16rpx;
  flex: none;
}

.load-more {
  text-align: center;
  padding: 24rpx 0 32rpx;
}

/* D65：批量条固定底盘/env 底垫由 components/bottom-bar 统一提供，本文件只保留条内布局 */
.batch-head {
  margin-bottom: 16rpx;
}

.batch-fail {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #FFF4E5;
}

.batch-fail-text {
  color: var(--v4-warning-text);
}

.batch-actions {
  display: flex;
}

.batch-btn {
  flex: 1;
}

.batch-tip {
  color: var(--v4-partner);
  margin-top: 8rpx;
}

/* D61/D62：件级取件行（每件已取状态 + 独立按钮；行内只列本站件） */
.piece-line--pick {
  align-items: center;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.piece-meta {
  font-size: 26rpx;
  color: var(--v4-text-2);
  margin-right: 12rpx;
}

.piece-index {
  font-size: 24rpx;
  color: var(--v4-text-4);
  margin-right: 10rpx;
}

.piece-picked {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
  margin-right: 12rpx;
}

.picked-count-tag {
  background: var(--v4-test-bg);
  color: var(--v4-partner);
  margin-left: 12rpx;
}

.piece-btn {
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.piece-other {
  color: var(--v4-readonly-text);
  padding: 4rpx 0;
}

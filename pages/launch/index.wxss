.launch-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.launch-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.launch-logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 32rpx;
  background: #1F7A5C;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.launch-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.launch-tip {
  font-size: 26rpx;
  color: #999999;
}

.launch-error {
  font-size: 28rpx;
  color: #E54D42;
  text-align: center;
  margin: 16rpx 0 48rpx;
  line-height: 1.6;
}

<view class="page-body">
  <switch-bar />

  <view class="role-hero">
    <view class="title">校园快递代取</view>
    <view class="subtitle">上传取件码截图，请兼职帮你取件送到宿舍。</view>
  </view>

  <view class="card" wx:if="{{bindCard}}">
    <view class="row between">
      <view class="col flex-1">
        <view class="section-title">兼职邀请你绑定</view>
        <view class="subtitle">{{bindCard.displayName}} · {{bindCard.partnerNo}}</view>
        <view class="muted">{{bindCard.servicesText}} · 服务范围 {{bindCard.zonesText || '全部苑'}}</view>
        <view class="muted" wx:if="{{!bindCard.acceptingOrders}}">这个兼职暂停接单，可以稍后再试。</view>
      </view>
    </view>
    <button class="btn btn-primary btn-block" bindtap="onBindTap">绑定这位兼职</button>
  </view>

  <view class="card" wx:if="{{bindLoading}}">
    <view class="empty-text">正在加载卡片邀请…</view>
  </view>

  <view class="card" wx:if="{{bindError}}">
    <view class="muted">{{bindError}}</view>
    <view class="muted">可以手动输入完整兼职编号后再绑定。</view>
  </view>

  <view class="role-cards">
    <view class="card role-card" bindtap="onCustomerTap">
      <view class="section-title">我是顾客</view>
      <view class="subtitle">上传取件码，请兼职代取。</view>
      <view class="role-action">进入顾客端</view>
    </view>
    <view class="card role-card" bindtap="onPartnerTap">
      <view class="section-title">我是兼职</view>
      <view class="subtitle">凭邀请码开通，接单取件。</view>
      <view class="role-action">进入兼职端</view>
    </view>
  </view>

  <view class="muted role-tip">同一个微信号可以同时是顾客和兼职，两边的数据互相隔离。</view>

  <button class="btn btn-ghost btn-block" bindtap="onInviteTap">有邀请码？去开通兼职身份</button>

  <view class="empty-text" wx:if="{{bindError}}" bindtap="onRetryBootstrap">重新加载</view>
</view>

/* pages/profile/index.wxss · 我的（顾客/兼职共用）页面级样式
   规则：token 与通用类在 app.wxss；本页只写页面私有类（门禁 #9）。 */

.profile-page {
  padding-bottom: 48rpx;
}

/* ── 头像 + 昵称 ─────────────────────────────────────────── */
.head-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.head-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.head-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.head-sub {
  font-size: 26rpx;
  color: #666666;
}

.head-edit {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1F7A5C;
  padding: 0 0 0 24rpx;
}

/* ── 停用/注销专用态 ─────────────────────────────────────── */
.state-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.state-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.state-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.state-btn {
  min-height: 88rpx;
}

.version-line {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 16rpx 0;
}

/* ── 编辑资料表单 ───────────────────────────────────────── */
.form-card {
  margin-bottom: 24rpx;
}

.avatar-row {
  align-items: flex-start;
  padding: 16rpx 0;
}

.avatar-pick {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F0F2F5;
  flex-shrink: 0;
}

.avatar-actions {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.mini-btn {
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #F6F7F9;
  color: #1F7A5C;
  margin: 0;
}

.mini-btn::after {
  border: none;
}

.avatar-default-link {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}

.form-hint {
  padding: 8rpx 0 16rpx;
  line-height: 1.5;
}

.dorm-preview {
  font-size: 26rpx;
  color: #1F7A5C;
  padding: 12rpx 0;
}

.form-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* ── 顾客资料卡（锚 + 同寝室标识 + 尾号）────────────────── */
.profile-card {
  padding-bottom: 24rpx;
}

.profile-line {
  min-height: 72rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.profile-line:last-of-type {
  border-bottom: none;
}

.profile-value {
  font-size: 30rpx;
  color: #1A1A1A;
}

.profile-hint {
  padding: 12rpx 0 24rpx;
  line-height: 1.5;
}

/* ── 编号卡 ─────────────────────────────────────────────── */
.id-card {
  padding: 24rpx;
}

.id-main {
  align-items: center;
}

.id-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
}

.id-hint {
  margin-top: 8rpx;
  line-height: 1.5;
}

.link {
  font-size: 28rpx;
  color: #1F7A5C;
  padding: 8rpx 0 8rpx 24rpx;
}

.link-danger {
  color: #E54D42;
}

/* ── 绑定卡 ─────────────────────────────────────────────── */
.section-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.binding-row {
  align-items: center;
  margin-bottom: 16rpx;
}

.binding-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.binding-name {
  font-size: 30rpx;
  font-weight: 500;
}

.binding-actions {
  gap: 16rpx;
}

/* ── 订单概览 ───────────────────────────────────────────── */
.order-summary {
  font-size: 30rpx;
  color: #1A1A1A;
}

.order-hint {
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ── 兼职分享 ───────────────────────────────────────────── */
.share-hint {
  margin-top: 16rpx;
  line-height: 1.5;
}

/* ── 列表卡 ─────────────────────────────────────────────── */
.list-card {
  padding: 24rpx;
}

.list-title {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.row-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 30rpx;
  color: #1A1A1A;
}

.row-item:last-child {
  border-bottom: none;
}

.row-item-disabled {
  color: #999999;
}

.row-arrow {
  font-size: 34rpx;
  color: #999999;
}

.badge-num {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #E54D42;
  color: #FFFFFF;
  font-size: 22rpx;
  margin-left: 12rpx;
  padding: 0 8rpx;
}

/* ── 解绑确认层 ─────────────────────────────────────────── */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 0 48rpx;
}

.dialog {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 16rpx;
}

.dialog-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.dialog-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.dialog-input {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #F6F7F9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.dialog-hint {
  margin-top: 12rpx;
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 32rpx;
}

/* 消息中心未读红点（UX_CUSTOMER §8.2：我的入口为红点，不显示数字） */
.red-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E54D42;
  margin-left: 12rpx;
  flex-shrink: 0;
}
